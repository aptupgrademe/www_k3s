---
# =============================================================================
# Host vars for hp1 (NAS, 192.168.10.50)
# Copy to vars.yml and fill in – never commit vars.yml to git.
# =============================================================================

# --- Connection ---
ansible_host: 192.168.10.50
ansible_user: raphael
ansible_port: 22

# --- System ---
nas_hostname:  hp1
nas_timezone:  Europe/Berlin

# --- ZFS pool ---
nas_zfs_pool:       data
nas_zfs_mountpoint: /raid5
nas_zfs_disks:
  - /dev/disk/by-id/ata-WD_Red_SA500_2.5_2TB_25273ZD00458   # sda
  - /dev/disk/by-id/ata-WD_Red_SA500_2.5_2TB_25273ZD01387   # sdc
  - /dev/disk/by-id/ata-WD_Red_SA500_2.5_2TB_25273ZD02050   # sdd

# --- SMART – disk IDs for monitoring ---
nas_disk_id_os:   ata-WDC_WDS500G1R0A-68A4W0_25422K801603     # sdb (OS)
nas_disk_id_zfs:
  - ata-WD_Red_SA500_2.5_2TB_25273ZD00458                     # sda
  - ata-WD_Red_SA500_2.5_2TB_25273ZD01387                     # sdc
  - ata-WD_Red_SA500_2.5_2TB_25273ZD02050                     # sdd
nas_disk_id_usb:  ata-TOSHIBA_MQ04ABD200_Y4BRP0B5T             # sde

# --- External HDD mount ---
nas_usb_disk_id: /dev/disk/by-id/ata-TOSHIBA_MQ04ABD200_Y4BRP0B5T-part1

# --- Samba ---
# Paths reference nas_zfs_mountpoint so they stay in sync with ZFS datasets.
nas_samba_workgroup: smb
nas_samba_shares:
  - name:        shared
    path:        "{{ nas_zfs_mountpoint }}/shared"
    valid_users: raphael
    force_user:  raphael
  - name:        angelika
    path:        "{{ nas_zfs_mountpoint }}/angelika"
    valid_users: raphael
    force_user:  raphael

# --- Jenkins ---
nas_jenkins_port: 8090
nas_jenkins_home: /var/lib/jenkins

# --- Email (used by ZED, SMART, unattended-upgrades, msmtp) ---
email: raphael.muench@proton.me
