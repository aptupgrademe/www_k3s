---
# =============================================================================
# Host variables – cvjm (Nextcloud only)
#
# Usage:
#   1. cp vars.yml.example vars.yml
#   2. Fill in all CHANGE_ME values
#   ansible-playbook nextcloud-k3s.yml --limit cvjm --ask-vault-pass
#
# Sensitive credentials (passwords) are in vault.yml – see vault.yml.example
# =============================================================================

# --- Connection ---
# Port 22 is the default on a fresh server.
# After the first playbook run + reboot, sshd switches to 10022 – change this to 10022 then.
ansible_user: root
ansible_port: 22
ansible_host: "{{ server_ipv4 }}"   # single source of truth, see --- Network --- below

# --- Network ---
server_ipv4: "CHANGE_ME"    # e.g. 1.2.3.4
server_ipv6: "CHANGE_ME"    # e.g. 2001:db8::1  – or remove if no public IPv6

# ===========================================================================
# NEXTCLOUD scenario
# ===========================================================================

# --- Network aliases ---
nextcloud_ipv4: "{{ server_ipv4 }}"
nextcloud_ipv6: "{{ server_ipv6 }}"

# --- Database ---
nextcloud_db:   "cvjm_nextcloud"
nextcloud_user: "nextcloud"      # DB username (password → vault.yml)

# --- Hostnames and URLs ---
nextcloud_hostname: "CHANGE_ME"                    # e.g. nextcloud.example.de
collabora_hostname: "CHANGE_ME"                    # e.g. collabora.example.de
nextcloud_url:      "https://{{ nextcloud_hostname }}"
collabora_url:      "https://{{ collabora_hostname }}"

# --- Paths ---
nextcloud_data_dir: "/data"

# --- WOPI allowlist ---
wopi_allowed_hosts:
  - "{{ k3s_pod_cidr }}"
  - "{{ k3s_service_cidr }}"
  - "{{ collabora_hostname }}"
  - "{{ nextcloud_ipv4 }}"

# ===========================================================================
# SHARED
# ===========================================================================

# --- Grafana ---
grafana_proxy_hostname: "{{ nextcloud_hostname }}"

# --- Mail / SMTP ---
mail_from_address: "nextcloud"           # local part only (before @)
mail_domain:       "CHANGE_ME"           # e.g. example.de
mail_smtphost:     "CHANGE_ME"           # e.g. smtp.strato.de
mail_smtpport:     "587"
mail_smtpauth:     true

# ===========================================================================
# RESOURCE SIZING (optional per-host overrides; defaults in group_vars/all.yml)
# ===========================================================================
# Example values for a roomy host (8 vCPU / 24 GB). A smaller host lowers these
# instead (see inventory/host_vars/sofie/vars.yml.example).

# MariaDB buffer pool - hold the whole DB in RAM with headroom (role default 256M).
mariadb_innodb_buffer_pool_size: "2G"

# PHP-FPM worker pool (defaults: 12 / 4 / 2 / 8).
nextcloud_fpm_max_children: 20
nextcloud_fpm_start_servers: 6
nextcloud_fpm_min_spare:    4
nextcloud_fpm_max_spare:    12

# K3s container requests/limits (defaults in group_vars/all.yml reproduce the
# previous hardcoded values). This host is roomy enough to keep the defaults, so
# they are left commented; uncomment and adjust to override:
# nextcloud_fpm_mem_request: "512Mi"
# nextcloud_fpm_cpu_request: "250m"
# nextcloud_fpm_mem_limit:   "4Gi"
# nextcloud_fpm_cpu_limit:   "1500m"
# collabora_mem_request:    "1Gi"
# collabora_cpu_request:    "500m"
# collabora_mem_limit:      "3Gi"    # ~12 concurrent Collabora editors
# collabora_cpu_limit:      "2000m"
# collabora_num_prealloc:    4
# collabora_max_concurrency: 4
