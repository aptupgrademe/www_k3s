---
# sofie – Sensitive credentials
# 1. Copy this file:  cp vault.yml.example vault.yml
# 2. Fill in your values below
# 3. Encrypt before committing to your private repo:
#      ansible-vault encrypt inventory/host_vars/sofie/vault.yml

# --- Let's Encrypt ---
email: "admin@example.de"

# --- MariaDB ---
mysql_root_password: "changeme"

# --- Nextcloud database ---
nextcloud_pass: "changeme"

# Read-only account for the mysqld_exporter metrics sidecar. Separate from the
# root password on purpose: the credentials land in /etc/mysqld_exporter.cnf,
# and reusing root's password there meant that file effectively stored the
# root login. The account itself is created automatically by the playbook.
nextcloud_db_exporter_pass: "changeme"

# --- Redis ---
# Redis binds to the node's public IP so K3s pods can reach it, previously
# protected by an nftables rule alone. It now also requires this password;
# the same value is handed to Nextcloud through the K8s Secret.
nextcloud_redis_pass: "changeme"

# --- Nextcloud admin account ---
nextcloud_admin_user: "admin"
nextcloud_admin_pass: "changeme"

# --- Grafana ---
grafana_basic_auth_user: "admin"
grafana_admin_pass:      "changeme"

# --- Mail / SMTP ---
mail_smtpname:     "nextcloud@example.de"
mail_smtppassword: "changeme"
