#!/usr/bin/env python3
"""Fake "k3s kubectl" for the nextcloud-update.yml scenarios (tests/update).
State (maintenance, needsDbUpgrade) lives in $SIM/state.json; every call that
matters is logged to $SIM/calls.log. $SCENARIO selects the fault:
  maintenance_before  instance already in maintenance mode
  upgrade_fails       occ upgrade aborts half-way (maintenance on, DB upgrade pending)
  apps_fail           occ app:update fails after a completed upgrade (maintenance left on)
  rollout_fails       rollout status times out
"""
import json, os, sys
sim, sc = os.environ["SIM"], os.environ.get("SCENARIO", "")
sf = os.path.join(sim, "state.json")
st = json.load(open(sf)) if os.path.exists(sf) else {
    "maintenance": sc == "maintenance_before", "needsDbUpgrade": False}
def save(): json.dump(st, open(sf, "w"))
def log(m): open(os.path.join(sim, "calls.log"), "a").write(m + "\n")
a = sys.argv[2:]
if a[0] == "exec":
    occ = a[a.index("/var/www/html/occ") + 1:]
    if occ[0] != "status": log("occ " + " ".join(occ))
    if occ[0] == "status":
        print(json.dumps({"installed": True, "version": "34.0.4.1", "versionstring": "34.0.4",
                          "maintenance": st["maintenance"], "needsDbUpgrade": st["needsDbUpgrade"]}))
    elif occ[0] == "upgrade" and sc == "upgrade_fails":
        st.update(maintenance=True, needsDbUpgrade=True); save()
        print("Exception: upgrade broke"); sys.exit(1)
    elif occ[0] == "upgrade":
        print("Nextcloud is already latest version")
    elif occ[0] == "app:update" and sc == "apps_fail":
        st.update(maintenance=True); save()
        print("app update crashed", file=sys.stderr); sys.exit(1)
    elif occ[0] == "maintenance:mode":
        st["maintenance"] = occ[1] != "--off"
    save(); sys.exit(0)
if a[0] == "rollout":
    log("rollout " + " ".join(a[1:3]))
    if sc == "rollout_fails" and a[1] == "status":
        print("error: deployment exceeded its progress deadline", file=sys.stderr); sys.exit(1)
    sys.exit(0)
if a[0] == "get" and "-o" in a and a[a.index("-o") + 1] == "json":
    deps = [("nextcloud", ["nextcloud:34.0.4-fpm", "nginx:1.30.5-alpine"]), ("collabora", ["collabora/code:26.04.5.1.1"])]
    if a[1] == "deployments":
        items = [{"metadata": {"name": n}, "spec": {"selector": {"matchLabels": {"app": n}},
                  "template": {"spec": {"containers": [{"image": i} for i in imgs]}}}} for n, imgs in deps]
    else:
        def ref(i): return ("docker.io/" if "/" in i else "docker.io/library/") + i.split(":")[0]
        items = [{"metadata": {"labels": {"app": n}}, "status": {"containerStatuses":
                  [{"imageID": f"{ref(i)}@sha256:RUN"} for i in imgs]}} for n, imgs in deps]
    print(json.dumps({"items": items})); sys.exit(0)
print("NAME READY STATUS\nnextcloud-x 1/1 Running")
