# Managed by Ansible (nas_pihole) – overrides for Pi-hole v6
# Applied on top of /etc/pihole/pihole.toml

[dns]
  upstreams = [
    "{{ nas_pihole_dns1 | default('8.8.8.8') }}",
    "{{ nas_pihole_dns2 | default('8.8.4.4') }}"
  ]
  interface = "{{ nas_pihole_interface | default('eno1') }}"

[webserver]
  # Non-standard ports to avoid conflict with other services
  port = "{{ nas_pihole_web_port | default('8000') }}o,{{ nas_pihole_web_port_tls | default('4443') }}os,[::]:{{ nas_pihole_web_port | default('8000') }}o,[::]:{{ nas_pihole_web_port_tls | default('4443') }}os"
