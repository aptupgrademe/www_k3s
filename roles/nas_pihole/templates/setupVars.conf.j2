# Managed by Ansible (nas_pihole) – used for unattended Pi-hole installation
PIHOLE_INTERFACE={{ nas_pihole_interface | default('eno1') }}
IPV4_ADDRESS={{ ansible_host }}/24
IPV6_ADDRESS=
PIHOLE_DNS_1={{ nas_pihole_dns1 | default('8.8.8.8') }}
PIHOLE_DNS_2={{ nas_pihole_dns2 | default('8.8.4.4') }}
QUERY_LOGGING=true
INSTALL_WEB_SERVER=true
INSTALL_WEB_INTERFACE=true
LIGHTTPD_ENABLED=false
CACHE_SIZE=10000
DNS_FQDN_REQUIRED=false
DNS_BOGUS_PRIV=true
DNSMASQ_LISTENING=single
WEBPASSWORD=
BLOCKING_ENABLED=true
