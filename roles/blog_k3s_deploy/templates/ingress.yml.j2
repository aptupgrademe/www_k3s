# Ingress resources – managed by Ansible (blog_k3s_deploy)
# F5 nginx-ingress requires Mergeable Ingresses when multiple Ingresses share
# the same hostname (e.g. main Ingress + cert-manager ACME solver Ingress).
#   master: TLS + server-level config, NO paths (F5 requirement)
#   minion: paths/routing + location-level config, NO TLS
# cert-manager solver Ingresses are created as minions via ClusterIssuer
# ingressTemplate annotations, so their challenge locations are merged in.
# Mirrors the pattern used by next_k3s_deploy/templates/ingress.yml.j2.

# ============================================================
# WordPress – MASTER (TLS + server config, no paths)
# ============================================================
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: wordpress
  namespace: wordpress
  annotations:
    cert-manager.io/cluster-issuer: "letsencrypt-prod"
    nginx.org/mergeable-ingress-type: "master"
    nginx.org/ssl-redirect: "false"
    # HTTPS redirect with /.well-known/ exception for ACME HTTP-01 challenges,
    # plus WordPress hardening (deny sensitive files, rate-limit wp-login.php).
    nginx.org/server-snippets: |
      set $redirect_https 0;
      if ($scheme = http)                       { set $redirect_https 1; }
      if ($request_uri ~ "^/.well-known/")      { set $redirect_https 0; }
      if ($redirect_https = 1)                  { return 301 https://$host$request_uri; }
      location = /xmlrpc.php  { deny all; return 403; }
      location = /readme.html { deny all; return 403; }
      location = /license.txt { deny all; return 403; }
      location = /wp-login.php {
        limit_req zone=wp_login burst=5 nodelay;
        proxy_pass http://wordpress.wordpress.svc.cluster.local;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
      }
spec:
  ingressClassName: nginx
  tls:
  - hosts:
    - {{ blog_hostname }}
    secretName: wordpress-tls
  rules:
  - host: {{ blog_hostname }}
    # No http.paths – required for F5 nginx-ingress master Ingress.
    # Paths are defined in the wordpress-routes minion Ingress below.

# ============================================================
# WordPress – MINION (paths + location-level config)
# ============================================================
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: wordpress-routes
  namespace: wordpress
  annotations:
    nginx.org/mergeable-ingress-type: "minion"
    # Security headers added to every response in the location context
    nginx.org/location-snippets: |
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
      add_header X-Frame-Options "SAMEORIGIN" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header Referrer-Policy "same-origin" always;
      add_header X-Permitted-Cross-Domain-Policies "none" always;
    # Upload size
    nginx.org/client-max-body-size: "500m"
    nginx.org/proxy-read-timeout: "300s"
    nginx.org/proxy-send-timeout: "300s"
    # Regex path matching for Grafana sub-path
    nginx.org/path-regex: "case_sensitive"
spec:
  ingressClassName: nginx
  rules:
  - host: {{ blog_hostname }}
    http:
      paths:
      # Grafana is proxied at /grafana/ to the host-side Grafana service.
      - path: /grafana(/|$)
        pathType: ImplementationSpecific
        backend:
          service:
            name: grafana
            port:
              number: 3000
      # Everything else goes to WordPress
      - path: /
        pathType: Prefix
        backend:
          service:
            name: wordpress
            port:
              number: 80
