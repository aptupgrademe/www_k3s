# Ingress resources – managed by Ansible (blog_k3s_deploy)
# F5 nginx-ingress requires Mergeable Ingresses when multiple Ingresses share
# the same hostname (e.g. main Ingress + cert-manager ACME solver Ingress).
#   master: TLS + server-level config, NO paths (F5 requirement)
#   minion: paths/routing + location-level config, NO TLS
# cert-manager solver Ingresses are created as minions via ClusterIssuer
# ingressTemplate annotations, so their challenge locations are merged in.
# Mirrors the pattern used by next_k3s_deploy/templates/ingress.yml.j2.

# ============================================================
# WordPress – MASTER (TLS + server config, no paths)
# ============================================================
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: wordpress
  namespace: wordpress
  annotations:
    cert-manager.io/cluster-issuer: "letsencrypt-prod"
    # Request an ECDSA P-256 leaf certificate instead of the cert-manager
    # default (RSA 2048). ECDSA signatures are much cheaper for the server to
    # compute during the TLS handshake, at equal or better security. Only
    # affects the server cert; the ACME account key on the ClusterIssuer is
    # unrelated. rotation-policy=Always gives a fresh key on every renewal.
    cert-manager.io/private-key-algorithm: "ECDSA"
    cert-manager.io/private-key-size: "256"
    cert-manager.io/private-key-rotation-policy: "Always"
    nginx.org/mergeable-ingress-type: "master"
    nginx.org/ssl-redirect: "false"
    # HTTPS redirect with /.well-known/ exception for ACME HTTP-01 challenges,
    # plus WordPress hardening (deny sensitive files, rate-limit wp-login.php).
    nginx.org/server-snippets: |
      set $redirect_https 0;
      if ($scheme = http)                       { set $redirect_https 1; }
      if ($request_uri ~ "^/.well-known/")      { set $redirect_https 0; }
      if ($redirect_https = 1)                  { return 301 https://$host$request_uri; }
      location = /xmlrpc.php  { deny all; return 403; }
      location = /readme.html { deny all; return 403; }
      location = /license.txt { deny all; return 403; }
      location = /wp-login.php {
        limit_req zone=wp_login burst=5 nodelay;
        proxy_pass http://wordpress.wordpress.svc.cluster.local;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
      }
spec:
  ingressClassName: nginx
  tls:
  - hosts:
    - {{ blog_hostname }}
    secretName: wordpress-tls
  rules:
  - host: {{ blog_hostname }}
    # No http.paths – required for F5 nginx-ingress master Ingress.
    # Paths are defined in the wordpress-routes minion Ingress below.

# ============================================================
# WordPress – MINION (paths + location-level config)
# ============================================================
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: wordpress-routes
  namespace: wordpress
  annotations:
    nginx.org/mergeable-ingress-type: "minion"
    # Security headers added to every response in the location context
    nginx.org/location-snippets: |
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
      add_header X-Frame-Options "SAMEORIGIN" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header Referrer-Policy "same-origin" always;
      add_header X-Permitted-Cross-Domain-Policies "none" always;
      add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;
      # Deprecated/ignored by modern browsers (superseded by CSP); kept only
      # to satisfy scanner checklists, no actual effect.
      add_header X-XSS-Protection "1; mode=block" always;
      # Report-Only: observes violations without blocking anything. Yoast's
      # inline JSON-LD, WP block-library inline CSS, and the /grafana/ proxy
      # path all need auditing before this can be promoted to an enforcing
      # Content-Security-Policy.
      add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss: https:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" always;
    # Upload size
    nginx.org/client-max-body-size: "500m"
    nginx.org/proxy-read-timeout: "300s"
    nginx.org/proxy-send-timeout: "300s"
    # Regex path matching for Grafana sub-path
    nginx.org/path-regex: "case_sensitive"
spec:
  ingressClassName: nginx
  rules:
  - host: {{ blog_hostname }}
    http:
      paths:
      # Grafana is proxied at /grafana/ to the host-side Grafana service.
      - path: /grafana(/|$)
        pathType: ImplementationSpecific
        backend:
          service:
            name: grafana
            port:
              number: 3000
      # Everything else goes to WordPress
      - path: /
        pathType: Prefix
        backend:
          service:
            name: wordpress
            port:
              number: 80

# ============================================================
# Bare/apex domain (e.g. apt-upgrade.me, no "www.") – 301 redirect to
# https://{{ blog_hostname }}. Own master (own hostname, own TLS cert - not
# merged with the wordpress Ingress above), so cert-manager's ACME solver for
# THIS host still needs the same minion treatment.
#
# Found 2026-08-20: the apex domain's DNS had stale/wrong records pointing
# at Strato's generic "domain reserved" parking page instead of this
# cluster, so nobody could reach the blog via the bare domain at all - fixed
# at the registrar, this Ingress is the server-side half of that fix so
# search engines/backlinks pointed at the apex land on the real site
# instead of a 404 (no Ingress rule existed for it) or a TLS handshake
# failure (no cert covered it).
# ============================================================
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: apt-upgrade-me-apex-redirect
  namespace: wordpress
  annotations:
    cert-manager.io/cluster-issuer: "letsencrypt-prod"
    cert-manager.io/private-key-algorithm: "ECDSA"
    cert-manager.io/private-key-size: "256"
    cert-manager.io/private-key-rotation-policy: "Always"
    nginx.org/mergeable-ingress-type: "master"
    nginx.org/ssl-redirect: "false"
    # /.well-known/ exception, but unlike the main WordPress master Ingress
    # (which only needs to force HTTPS - everything else is the real
    # destination), THIS Ingress redirects everything including HTTPS
    # traffic, so the exception has to skip the redirect outright, not just
    # the "force https" branch. Got this wrong on the first attempt: an
    # unconditional trailing `return 301` after the well-known exception
    # still fired for the exempted path, so cert-manager's HTTP-01 challenge
    # request got redirected to https://{{ blog_hostname }}/.well-known/...
    # instead of being answered here - which 404s there (no such path on
    # the main site) and cert-manager reported "wrong status code 404,
    # expected 200", blocking certificate issuance entirely (verified live
    # 2026-08-20).
    nginx.org/server-snippets: |
      set $redirect_to_www 1;
      if ($request_uri ~ "^/.well-known/") { set $redirect_to_www 0; }
      if ($redirect_to_www = 1)            { return 301 https://{{ blog_hostname }}$request_uri; }
spec:
  ingressClassName: nginx
  tls:
  - hosts:
    - {{ blog_hostname | regex_replace('^www\.', '') }}
    secretName: apt-upgrade-me-apex-tls
  rules:
  - host: {{ blog_hostname | regex_replace('^www\.', '') }}
    # No http.paths - required for F5 nginx-ingress master Ingress, same as
    # the wordpress master above. Got this wrong on the first attempt too:
    # added a dummy "/" path here assuming K8s required at least one, which
    # instead made F5 reject the whole Ingress outright ("Too many: 1: must
    # have at most 0 items", verified live in the controller's event log) -
    # meaning NO server block for this host was ever generated, and every
    # request (including the ACME challenge) fell through to nginx's global
    # default 404, regardless of the server-snippet or the minion below.
    # None needed anyway: the server-snippet's `return 301` fires before any
    # location matching, so there's no real destination behind this host
    # except cert-manager's own ACME solver minion (auto-injected below).
