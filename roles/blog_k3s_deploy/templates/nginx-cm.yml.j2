# Nginx ConfigMap for the WordPress sidecar – managed by Ansible (blog_k3s_deploy)
# TLS is terminated by F5 nginx-ingress; this block handles port 80 only.
# PHP requests are forwarded to the FPM container via 127.0.0.1:9000.
apiVersion: v1
kind: ConfigMap
metadata:
  name: wordpress-nginx-config
  namespace: wordpress
data:
  default.conf: |
    server {
        listen 80;
        server_tokens off;

        root /var/www/html;
        index index.php index.html;

        client_max_body_size 500m;

        # Trust X-Forwarded-* headers from F5 nginx-ingress (K3s pod CIDR)
        set_real_ip_from {{ k3s_pod_cidr }};
        real_ip_header   X-Forwarded-For;
        real_ip_recursive on;

        # -------------------------------------------------------
        # Gzip compression (HTML, CSS, JS, JSON, XML, fonts)
        # -------------------------------------------------------
        gzip              on;
        # Serve the .gz that wp-super-cache already wrote next to each cached
        # page instead of recompressing on the fly (falls back to on-the-fly
        # gzip when no precompressed file exists).
        gzip_static       on;
        gzip_vary         on;
        gzip_proxied      any;
        gzip_comp_level   6;
        gzip_min_length   1024;
        gzip_types
            text/plain text/css text/xml text/javascript
            application/javascript application/json application/xml
            application/rss+xml image/svg+xml font/woff2;

        # -------------------------------------------------------
        # Security: block sensitive files and info disclosure
        # -------------------------------------------------------
        location = /xmlrpc.php          { deny all; }
        location = /wp-config.php       { deny all; }
        location = /readme.html         { deny all; }
        location = /license.txt         { deny all; }
        location ~ /\.                  { deny all; }
        # Plugin/theme readme files (e.g. wp-content/plugins/*/readme.txt)
        # leak exact component versions for CVE matching. The two core files
        # above are already denied; this covers the per-plugin ones too.
        location ~* /readme\.(txt|html)$ { deny all; }
        # install.php reports "Already Installed" on a live site (harmless in
        # itself) but there is no reason to expose the installer surface.
        location = /wp-admin/install.php       { deny all; }
        location = /wp-admin/setup-config.php  { deny all; }
        # .phar is in this list because "location ~ \.php$" below does NOT
        # match it: a phar in the document root is otherwise handed out as a
        # plain static download (verified live - wp-cli.phar was fetchable
        # at /wp-cli.phar, 7 MB, HTTP 200). WP-CLI has since been moved out
        # of the web root entirely; this stays as the backstop.
        #
        # Also covers editor backup suffixes NOT in the original list: .save
        # (nano, which IS installed on the host), .old/.tmp, and the trailing
        # ~ that gedit/emacs leave. A stray wp-config.php.save in the web root
        # would otherwise be served as plaintext, exposing the DB credentials.
        location ~* (\.(bak|orig|save|old|tmp|swp|swo|hta|sql|phar|phps)|~)$ { deny all; }
        # Block username enumeration via ?author= parameter
        if ($arg_author != "") { return 403; }

        # -------------------------------------------------------
        # WP-Super-Cache: serve pre-rendered pages straight from nginx
        # -------------------------------------------------------
        # The plugin runs in PHP mode (wp_cache_mod_rewrite=0), so without this
        # block every anonymous hit still boots a PHP-FPM worker only to echo a
        # static file. Here nginx serves the cached HTML itself and falls
        # through to WordPress only when there is no cache file — which keeps
        # PHP-FPM free during bot/scanner storms (the bulk of this site's
        # traffic). Cache files are named index-https.html because the pod tells
        # PHP the request is HTTPS (fastcgi_param HTTPS on, above).
        #
        # $cache_uri mirrors the plugin's own bypass rules: any request that
        # must reach live PHP is rewritten to the non-existent path segment
        # "null cache" (a space can't occur in a slug/dir), so try_files skips
        # the cache and goes to index.php. These `if`s run on every request —
        # keep the list short.
        set $cache_uri $request_uri;
        if ($request_method = POST)  { set $cache_uri 'null cache'; }
        if ($query_string != "")     { set $cache_uri 'null cache'; }
        if ($request_uri ~* "/wp-admin/|/wp-json/|/feed/|/sitemap.*\.xml") { set $cache_uri 'null cache'; }
        # Logged-in users, recent commenters and password-protected posts must
        # never be handed another visitor's cached copy.
        if ($http_cookie ~* "comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_logged_in") { set $cache_uri 'null cache'; }

        location / {
            # Pre-rendered supercache file first (HTTPS variant, then plain),
            # then the real file, then hand off to WordPress. Doubled slashes
            # from joining "/" + $request_uri collapse harmlessly on Linux.
            try_files /wp-content/cache/supercache/{{ blog_hostname }}/$cache_uri/index-https.html
                      /wp-content/cache/supercache/{{ blog_hostname }}/$cache_uri/index.html
                      $uri $uri/ /index.php?$args;
        }

        # -------------------------------------------------------
        # PHP-FPM (FPM listens on TCP 9000 in the same pod)
        # -------------------------------------------------------
        location ~ \.php$ {
            include        fastcgi_params;
            fastcgi_param  SCRIPT_FILENAME  $document_root$fastcgi_script_name;
            # TLS is terminated at F5 nginx-ingress; tell PHP it's HTTPS
            fastcgi_param  HTTPS            on;
            fastcgi_param  HTTP_SCHEME      https;
            fastcgi_pass   127.0.0.1:9000;
            fastcgi_read_timeout          300s;
            fastcgi_intercept_errors      on;
            fastcgi_request_buffering     off;
            # Hide PHP version from response headers
            fastcgi_hide_header           X-Powered-By;
        }

        # -------------------------------------------------------
        # Static asset caching
        # -------------------------------------------------------
        location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|webp|avif|woff2?|ttf|eot|otf)$ {
            expires 30d;
            add_header Cache-Control "public, max-age=2592000";
            log_not_found off;
            access_log    off;
        }

        # Serve PGP public key as a direct download
        location = /publickey.asc {
            default_type application/pgp-keys;
            add_header Content-Disposition "attachment; filename=\"publickey.asc\"";
        }

        # robots.txt is generated dynamically by Yoast SEO (no static file exists).
        # Pass to WordPress via try_files so the virtual URL is resolved by PHP.
        location = /robots.txt  {
            allow all;
            log_not_found off;
            access_log    off;
            try_files $uri $uri/ /index.php?$args;
        }
        location = /favicon.ico { log_not_found off; access_log off; }

        access_log /dev/stdout;
        error_log  /dev/stderr warn;
    }
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: wordpress-php-config
  namespace: wordpress
data:
  uploads.ini: |
    ; --- Upload limits ---
    upload_max_filesize = 500M
    post_max_size       = 500M
    memory_limit        = 512M
    max_execution_time  = 300

    ; --- Realpath cache (avoid repeated filesystem lookups) ---
    realpath_cache_size = 4096K
    realpath_cache_ttl  = 3600

    ; --- OPcache (production tuning) ---
    ; validate_timestamps=0: never check file mtimes – pod restart clears cache on deploy
    opcache.enable                 = 1
    opcache.memory_consumption     = 128
    opcache.interned_strings_buffer = 16
    opcache.max_accelerated_files  = 10000
    opcache.validate_timestamps    = 0
    opcache.revalidate_freq        = 0
    opcache.fast_shutdown          = 1
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: wordpress-fpm-pool-config
  namespace: wordpress
data:
  z-monitoring.conf: |
    [www]
    ; --- Monitoring ---
    pm.status_path = /fpm-status
    slowlog = /proc/1/fd/2
    request_slowlog_timeout = 5s

    ; --- Pool tuning ---
    ; Sized for a 4-core node with wordpress-fpm cpu limit=2000m, memory limit=1Gi.
    ; max_children is capped by memory, not CPU: 12 workers at the ~55-70 MB
    ; RSS typical for this plugin set plus the 128 MB shared OPcache segment
    ; fits inside 1Gi with headroom. The previous 16/768Mi pairing could not
    ; have reached its own max_children without risking an OOM kill.
    pm.max_children      = 12
    pm.start_servers     = 4
    pm.min_spare_servers = 2
    pm.max_spare_servers = 8
    ; Recycle workers after 500 requests to prevent PHP memory leaks
    pm.max_requests      = 500
