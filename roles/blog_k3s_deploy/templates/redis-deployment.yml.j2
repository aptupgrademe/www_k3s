# Redis Deployment + Service – managed by Ansible (blog_k3s_deploy)
# Pure in-memory object cache for WordPress (WP Redis plugin).
# Persistence is disabled: --save "" --appendonly no
# On pod restart the cache is empty; WordPress falls back to DB queries
# temporarily until Redis warms up again. This is acceptable for a cache.
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redis
  namespace: wordpress
  labels:
    app: redis
spec:
  replicas: 1
  selector:
    matchLabels:
      app: redis
  template:
    metadata:
      labels:
        app: redis
    spec:
      containers:
      - name: redis
        image: {{ blog_image_redis }}
        securityContext:
          allowPrivilegeEscalation: false
        # Disable all persistence – RAM-only cache, restarts start fresh.
        command: ["redis-server", "--save", "", "--appendonly", "no"]
        ports:
        - containerPort: 6379
          name: redis
        resources:
          requests:
            memory: "32Mi"
            cpu: "10m"
          limits:
            memory: "128Mi"
            cpu: "200m"
        readinessProbe:
          exec:
            command: ["redis-cli", "ping"]
          initialDelaySeconds: 5
          periodSeconds: 10
          failureThreshold: 3
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: wordpress
  labels:
    app: redis
spec:
  selector:
    app: redis
  ports:
  - name: redis
    port: 6379
    targetPort: 6379
    protocol: TCP
  type: ClusterIP
