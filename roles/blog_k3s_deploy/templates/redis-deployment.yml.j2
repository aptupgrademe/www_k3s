# Redis Deployment + Service – managed by Ansible (blog_k3s_deploy)
# Pure in-memory object cache for WordPress (WP Redis plugin).
# Persistence is disabled: --save "" --appendonly no
# On pod restart the cache is empty; WordPress falls back to DB queries
# temporarily until Redis warms up again. This is acceptable for a cache.
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redis
  namespace: wordpress
  labels:
    app: redis
spec:
  replicas: 1
  selector:
    matchLabels:
      app: redis
  template:
    metadata:
      labels:
        app: redis
    spec:
      containers:
      - name: redis
        image: {{ blog_image_redis }}
        # Entrypoint starts as root and re-execs as the redis user; the
        # server itself listens on 6379, so no NET_BIND_SERVICE needed.
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop: [ALL]
            add: [SETGID, SETUID]
          seccompProfile:
            type: RuntimeDefault
        # Disable all persistence – RAM-only cache, restarts start fresh.
        # maxmemory is set well below the 128Mi container limit (mem_fragmentation_ratio
        # observed at 2.73 live, i.e. actual RSS usage is well above Redis' own
        # accounting) so Redis evicts under its own steam instead of being
        # OOM-killed by the kernel once the cgroup limit is hit. allkeys-lru is
        # correct here since every key in this instance is a disposable cache
        # entry – nothing needs eviction protection.
        command: ["redis-server", "--save", "", "--appendonly", "no", "--maxmemory", "80mb", "--maxmemory-policy", "allkeys-lru"]
        ports:
        - containerPort: 6379
          name: redis
        resources:
          requests:
            memory: "32Mi"
            cpu: "10m"
          limits:
            memory: "128Mi"
            cpu: "200m"
        readinessProbe:
          exec:
            command: ["redis-cli", "ping"]
          initialDelaySeconds: 5
          periodSeconds: 10
          failureThreshold: 3
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: wordpress
  labels:
    app: redis
spec:
  selector:
    app: redis
  ports:
  - name: redis
    port: 6379
    targetPort: 6379
    protocol: TCP
  type: ClusterIP
