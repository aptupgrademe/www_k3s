# WordPress K8s Secret – managed by Ansible (blog_k3s_deploy)
# Contains sensitive credentials for the WordPress container.
# The file is written to /tmp with mode 0600 and removed after apply.
apiVersion: v1
kind: Secret
metadata:
  name: wordpress-secrets
  namespace: wordpress
type: Opaque
stringData:
  db-host: "mariadb"
  db-root-password: "{{ mysql_root_password }}"
  db-name: "{{ blog_db }}"
  db-user: "{{ blog_db_user }}"
  db-password: "{{ blog_db_pass }}"
  admin-user: "{{ blog_admin_user }}"
  admin-password: "{{ blog_admin_pass }}"
  admin-email: "{{ blog_admin_email }}"
  db-exporter-password: "{{ blog_db_exporter_pass }}"
  # mysqld_exporter v0.19.0 requires --config.my-cnf; DATA_SOURCE_NAME is not supported.
  # Mounted as /etc/mysqld_exporter.cnf in the mysqld-exporter sidecar.
  #
  # Deliberately NOT the root account: this file is readable inside the
  # exporter container, so whatever credentials sit here are exposed to a
  # sidecar whose only job is scraping counters. The 'exporter' user is
  # created in tasks/mariadb.yml with PROCESS + REPLICATION CLIENT and
  # SELECT on performance_schema only — no write access, no access to the
  # WordPress tables, no ability to grant itself more.
  mysqld-exporter-cnf: |
    [client]
    user=exporter
    password={{ blog_db_exporter_pass }}
    host=127.0.0.1
    port=3306
