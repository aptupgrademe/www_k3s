# WordPress Deployment + Service – managed by Ansible (blog_k3s_deploy)
# Pod contains two containers:
#   wordpress-fpm  – PHP-FPM (port 9000) – official wordpress:fpm image
#   nginx          – Nginx sidecar (port 80), serves static files + proxies PHP
#
# The wordpress:fpm image auto-creates wp-config.php on first start when
# WORDPRESS_DB_* env vars are set.  WP-CLI is downloaded and checksum-verified
# by the init container into /usr/local/lib/wp-cli/wp-cli.phar (an emptyDir,
# outside the document root) and used by the blog_wordpress Ansible role
# (kubectl exec) for the initial installation and plugin setup.
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: wordpress
  namespace: wordpress
  labels:
    app: wordpress
spec:
  replicas: 1
  # Recreate ensures only one pod accesses the RWO HostPath volume at a time.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: wordpress
  template:
    metadata:
      labels:
        app: wordpress
    spec:
      # WordPress/nginx/exporters never talk to the Kubernetes API — no SA token needed.
      automountServiceAccountToken: false
      # -------------------------------------------------------------------
      # Init container: fix HostPath directory ownership and download WP-CLI
      # The wordpress:fpm image runs as www-data (uid 33).
      #
      # WP-CLI deliberately does NOT go into /var/www/html: everything under
      # the document root is reachable over HTTP, and nginx's deny list only
      # covers .php (not .phar), so a phar dropped there is simply served as
      # a 7 MB download to anyone who asks. It lives in its own emptyDir
      # instead, shared with the fpm container but outside the web root.
      #
      # The download is pinned to a version + SHA-512 (group_vars/all.yml):
      # busybox wget does not verify TLS certificates, and the blog_wordpress
      # role runs this phar with --allow-root, so an unverified binary would
      # be arbitrary root-level code execution. A hash mismatch aborts the
      # init container and the pod never starts.
      # -------------------------------------------------------------------
      initContainers:
      - name: init-dirs
        image: {{ blog_image_busybox }}
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop: [ALL]
            add: [CHOWN, FOWNER, DAC_OVERRIDE]
          seccompProfile:
            type: RuntimeDefault
        command:
        - sh
        - -c
        - |
          set -e
          chown -R 33:33 /var/www/html
          chmod 0755 /var/www/html
          # Same Calico/Felix startup race as the wp-cron container (see
          # cronjob.yml.j2): a brand-new pod's first outbound connection can
          # fail before NetworkPolicy egress rules are programmed. Caused a
          # live outage 2026-08-26 - this init container's wget to GitHub
          # hung on a rollout restart, the old pod had already been
          # terminated (single replica, no maxUnavailable buffer), site
          # returned 502 until the init container was retried by hand.
          sleep 5
          echo "Downloading WP-CLI {{ blog_wp_cli_version }}..."
          wget -q -O /wp-cli/wp-cli.phar \
            https://github.com/wp-cli/wp-cli/releases/download/v{{ blog_wp_cli_version }}/wp-cli-{{ blog_wp_cli_version }}.phar
          echo "{{ blog_wp_cli_sha512 }}  /wp-cli/wp-cli.phar" | sha512sum -c -
          chmod 0755 /wp-cli/wp-cli.phar
          # Remove any copy left in the web root by an earlier revision of
          # this template, where it was publicly downloadable.
          rm -f /var/www/html/wp-cli.phar
          echo "Init complete."
        volumeMounts:
        - name: wordpress-www
          mountPath: /var/www/html
        - name: wp-cli
          mountPath: /wp-cli

      containers:
      # -------------------------------------------------------------------
      # Container 1: WordPress PHP-FPM
      # The official image auto-creates wp-config.php from env vars.
      # wp core install is handled by blog_wordpress role via kubectl exec.
      # -------------------------------------------------------------------
      - name: wordpress-fpm
        image: {{ blog_image_wordpress }}
        # CHOWN/SETUID/SETGID: the fpm master starts as root and forks
        # workers as www-data. DAC_OVERRIDE/FOWNER: the image entrypoint
        # untars WordPress into the volume and sets modes on first start —
        # verified that dropping these two makes the container fail with
        # "tar: Cannot change mode ... Operation not permitted".
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop: [ALL]
            add: [CHOWN, SETGID, SETUID, DAC_OVERRIDE, FOWNER]
          seccompProfile:
            type: RuntimeDefault
        env:
        # Database
        - name: WORDPRESS_DB_HOST
          valueFrom:
            secretKeyRef:
              name: wordpress-secrets
              key: db-host
        - name: WORDPRESS_DB_NAME
          valueFrom:
            secretKeyRef:
              name: wordpress-secrets
              key: db-name
        - name: WORDPRESS_DB_USER
          valueFrom:
            secretKeyRef:
              name: wordpress-secrets
              key: db-user
        # CIS 5.4.1: file, not a plain env var - env vars are visible via
        # /proc/<pid>/environ, `kubectl describe`, crash dumps, and error
        # handlers that dump the environment. wp-config-docker.php's
        # getenv_docker() checks the _FILE variant first (docker-library
        # convention), so this needs no wp-config changes.
        - name: WORDPRESS_DB_PASSWORD_FILE
          value: /etc/secrets/db-password
        # Force WordPress to use the correct public URL regardless of auto-detection.
        # Without this the container may derive a wrong siteurl from SCRIPT_FILENAME.
        - name: WORDPRESS_CONFIG_EXTRA
          value: |
            define('WP_HOME',    'https://{{ blog_hostname }}');
            define('WP_SITEURL', 'https://{{ blog_hostname }}');
            define('WP_REDIS_HOST',     'redis');
            define('WP_REDIS_PORT',     6379);
            define('WP_REDIS_DATABASE', 0);
            define('WP_REDIS_SCHEME',   'tcp');
            // Bounds cache growth: without this, object-cache entries never
            // expire (verified live: 4481 keys in Redis, only 29 had a TTL).
            // Combined with Redis' own maxmemory/eviction below, this keeps
            // the dataset self-cleaning instead of growing indefinitely.
            define('WP_REDIS_MAXTTL', 86400);
            define('WP_CACHE', true);
            define('WPCACHEHOME', '/var/www/html/wp-content/plugins/wp-super-cache/');
            // Disable the built-in plugin/theme file editor. Without this,
            // any compromise of an administrator account is a one-click
            // path to executing arbitrary PHP - no vulnerability required.
            // DISALLOW_FILE_MODS is deliberately NOT set: it would also
            // block the plugin auto-updates this site relies on.
            define('DISALLOW_FILE_EDIT', true);
        ports:
        - containerPort: 9000
          name: fpm
        volumeMounts:
        - name: wordpress-www
          mountPath: /var/www/html
        - name: php-config
          mountPath: /usr/local/etc/php/conf.d/uploads.ini
          subPath: uploads.ini
        - name: fpm-pool-config
          mountPath: /usr/local/etc/php-fpm.d/z-monitoring.conf
          subPath: z-monitoring.conf
        - name: tmp
          mountPath: /tmp
        - name: wp-cli
          mountPath: /usr/local/lib/wp-cli
          readOnly: true
        - name: db-credentials
          mountPath: /etc/secrets
          readOnly: true
        resources:
          requests:
            memory: "256Mi"
            cpu: "200m"
          limits:
            # Node has 4 cores; give FPM room to run pm.max_children workers
            # truly in parallel instead of throttling them to <1 core.
            #
            # Memory sized against the pool: pm.max_children=12 at the ~55-70 MB
            # per-worker RSS typical for this plugin set is ~800 MB, plus the
            # 128 MB shared OPcache segment and the master process. At the
            # previous 768Mi the pool could not actually reach max_children
            # under load without risking an OOM kill, so the limit followed
            # the pool rather than the other way round (node has 7.6 GB).
            memory: "1Gi"
            cpu: "2000m"
        readinessProbe:
          tcpSocket:
            port: 9000
          initialDelaySeconds: 20
          periodSeconds: 15
          failureThreshold: 5
        livenessProbe:
          exec:
            command: ["sh", "-c", "kill -0 1"]
          initialDelaySeconds: 60
          periodSeconds: 30
          failureThreshold: 3

      # -------------------------------------------------------------------
      # Container 2: php-fpm_exporter – Prometheus metrics for PHP-FPM
      # Scrapes the FPM status page via FastCGI on 127.0.0.1:9000.
      # Requires pm.status_path = /fpm-status in the FPM pool config.
      # -------------------------------------------------------------------
      - name: php-fpm-exporter
        image: {{ blog_image_fpm_exporter }}
        # Static Go binary, listens on a high port, never switches user:
        # needs no capabilities at all.
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop: [ALL]
          seccompProfile:
            type: RuntimeDefault
        env:
        - name: PHP_FPM_SCRAPE_URI
          value: "tcp://127.0.0.1:9000/fpm-status"
        - name: PHP_FPM_FIX_PROCESS_COUNT
          value: "true"
        ports:
        - containerPort: 9253
          name: metrics
        resources:
          requests:
            memory: "16Mi"
            cpu: "10m"
          limits:
            memory: "64Mi"
            cpu: "50m"

      # -------------------------------------------------------------------
      # Container 3: Nginx sidecar
      # Serves static files, proxies PHP requests to FPM.
      # -------------------------------------------------------------------
      - name: nginx
        image: {{ blog_image_nginx }}
        # NET_BIND_SERVICE: the master binds :80, and once ALL capabilities
        # are dropped even uid 0 loses the implicit permission for ports
        # <1024. CHOWN/SETUID/SETGID: workers are forked as the nginx user.
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop: [ALL]
            add: [CHOWN, SETGID, SETUID, NET_BIND_SERVICE]
          seccompProfile:
            type: RuntimeDefault
        ports:
        - containerPort: 80
          name: http
        volumeMounts:
        - name: wordpress-www
          mountPath: /var/www/html
          readOnly: true
        - name: nginx-config
          mountPath: /etc/nginx/conf.d/default.conf
          subPath: default.conf
        resources:
          requests:
            memory: "32Mi"
            cpu: "25m"
          limits:
            memory: "128Mi"
            cpu: "500m"
        readinessProbe:
          tcpSocket:
            port: 80
          initialDelaySeconds: 20
          periodSeconds: 15
          failureThreshold: 5

      # -------------------------------------------------------------------
      # Volumes
      # -------------------------------------------------------------------
      volumes:
      - name: wordpress-www
        hostPath:
          path: {{ blog_k3s_www_dir }}
          type: DirectoryOrCreate
      - name: nginx-config
        configMap:
          name: wordpress-nginx-config
      - name: php-config
        configMap:
          name: wordpress-php-config
      - name: fpm-pool-config
        configMap:
          name: wordpress-fpm-pool-config
      # CIS 5.4.1: DB password delivered as a file, not a plain env var.
      # Secret volumes are owned by root:root, and PHP-FPM reads this as
      # www-data (uid 33), so it has to be world-readable inside the
      # container. Same pattern as the exporter credentials below.
      - name: db-credentials
        secret:
          secretName: wordpress-secrets
          items:
          - key: db-password
            path: db-password
          defaultMode: 0444
      # RAM-backed tmpfs for PHP-FPM temp files (uploads, wp-cron tmp, etc.).
      # Content is lost on pod restart – acceptable for transient files.
      - name: tmp
        emptyDir:
          medium: Memory
          sizeLimit: 64Mi
      # WP-CLI lives here rather than in the document root, so it is not
      # reachable over HTTP. Re-downloaded and re-verified on every pod start.
      - name: wp-cli
        emptyDir:
          sizeLimit: 32Mi
---
apiVersion: v1
kind: Service
metadata:
  name: wordpress
  namespace: wordpress
  labels:
    app: wordpress
spec:
  selector:
    app: wordpress
  ports:
  - name: http
    port: 80
    targetPort: 80
    protocol: TCP
  type: ClusterIP
