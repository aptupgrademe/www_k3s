# Managed by Ansible (common_selinux_monitoring) - local SELinux module.
# Gives prometheus its own domain instead of unconfined_service_t.
policy_module(homelab_prometheus, 1.1.0)

type homelab_prometheus_t;
type homelab_prometheus_exec_t;
# systemd (init_t) starts the binary -> transition into the domain
init_daemon_domain(homelab_prometheus_t, homelab_prometheus_exec_t)
# The units run with NoNewPrivileges; under NNP the policy refuses the
# transition unless it is granted explicitly (the MariaDB lesson): without
# this the service stays in init_t and cannot read its own data.
init_nnp_daemon_domain(homelab_prometheus_t)

# TSDB in /var/lib/prometheus
type homelab_prometheus_var_lib_t;
files_type(homelab_prometheus_var_lib_t)

# Reviewed 2026-10-20 from one day of learning-phase AVCs on the blog
# (incl. a reboot); audit2allow -R was the draft, not the result.

# the TSDB (compaction renames, deletes and mmaps blocks)
manage_dirs_pattern(homelab_prometheus_t, homelab_prometheus_var_lib_t, homelab_prometheus_var_lib_t)
manage_files_pattern(homelab_prometheus_t, homelab_prometheus_var_lib_t, homelab_prometheus_var_lib_t)
allow homelab_prometheus_t homelab_prometheus_var_lib_t:file map;
files_search_var_lib(homelab_prometheus_t)

# listen on 9090; scrape node_exporter 9100, kubelet 10250, the NodePorts
allow homelab_prometheus_t self:tcp_socket create_stream_socket_perms;
corenet_tcp_bind_generic_node(homelab_prometheus_t)
corenet_tcp_bind_websm_port(homelab_prometheus_t)
corenet_tcp_connect_hplip_port(homelab_prometheus_t)
corenet_tcp_connect_kubernetes_port(homelab_prometheus_t)
corenet_tcp_connect_unreserved_ports(homelab_prometheus_t)
sysnet_read_config(homelab_prometheus_t)

# Go runtime: user lookup, cgroup limits, /sys, filesystem attributes
auth_read_passwd_file(homelab_prometheus_t)
fs_search_cgroup_dirs(homelab_prometheus_t)
fs_read_cgroup_files(homelab_prometheus_t)
fs_getattr_xattr_fs(homelab_prometheus_t)
dev_read_sysfs(homelab_prometheus_t)
kernel_read_net_sysctls(homelab_prometheus_t)
kernel_search_network_sysctl(homelab_prometheus_t)


{% if selinux_monitoring_permissive | bool %}
# Learning phase: log denials, do not enforce (selinux_monitoring_permissive)
permissive homelab_prometheus_t;
{% endif %}
