// {{ ansible_managed }}
// Grafana Alloy: journal, pod logs and a few log files -> local Loki.
logging {
  level = "warn"
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:{{ loki_http_port }}/loki/api/v1/push"
  }
  external_labels = { host = "{{ inventory_hostname }}" }
}

// --- systemd journal -------------------------------------------------------
// unit, level and transport become labels; transport="kernel" finds the
// kernel's own messages (OOM killer, segfaults).
loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
  rule {
    source_labels = ["__journal__transport"]
    target_label  = "transport"
  }
}

loki.source.journal "journal" {
  max_age       = "12h"
  relabel_rules = loki.relabel.journal.rules
  labels        = { job = "journal" }
  forward_to    = [loki.write.local.receiver]
}

// --- pod logs (/var/log/pods/<ns>_<pod>_<uid>/<container>/N.log) ------------
local.file_match "pods" {
  path_targets = [{ "__path__" = "/var/log/pods/*/*/*.log", "job" = "pods" }]
}

discovery.relabel "pods" {
  targets = local.file_match.pods.targets
  rule {
    source_labels = ["__path__"]
    regex         = "/var/log/pods/([^_]+)_([^_]+)_[^/]+/([^/]+)/.*"
    target_label  = "namespace"
    replacement   = "$1"
  }
  rule {
    source_labels = ["__path__"]
    regex         = "/var/log/pods/([^_]+)_([^_]+)_[^/]+/([^/]+)/.*"
    target_label  = "pod"
    replacement   = "$2"
  }
  rule {
    source_labels = ["__path__"]
    regex         = "/var/log/pods/([^_]+)_([^_]+)_[^/]+/([^/]+)/.*"
    target_label  = "container"
    replacement   = "$3"
  }
}

loki.source.file "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.process.pods.receiver]
}

// stage.cri strips the containerd prefix (time, stream, P/F flag) and
// joins partial lines.
loki.process "pods" {
  stage.cri {}
  stage.label_drop {
    values = ["filename"]
  }
  forward_to = [loki.write.local.receiver]
}

// --- plain log files ---------------------------------------------------------
local.file_match "files" {
  path_targets = [
{% for f in loki_file_sources %}
    { "__path__" = "{{ f.path }}", "job" = "{{ f.job }}" },
{% endfor %}
  ]
}

loki.source.file "files" {
  targets    = local.file_match.files.targets
  forward_to = [loki.process.files.receiver]
}

// Without a parsed time every line gets the moment Alloy READ it - on the
// first start that is the whole backlog of audit.log/fail2ban.log "now",
// which made the log alerts fire on hours-old lines (found 2026-10-19).
loki.process "files" {
  stage.match {
    selector = "{job=\"audit\"}"
    stage.regex {
      expression = "msg=audit\\((?P<ts>[0-9]+[.][0-9]+):"
    }
    stage.timestamp {
      source = "ts"
      format = "Unix"
    }
  }
  // fail2ban writes local time without a zone - the host's zone is
  // read by the role (timedatectl) and passed in here.
  stage.match {
    selector = "{job=\"fail2ban\"}"
    stage.regex {
      expression = "^(?P<ts>[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2},[0-9]{3})"
    }
    stage.timestamp {
      source   = "ts"
      format   = "2006-01-02 15:04:05,000"
      location = "{{ _loki_host_tz }}"
    }
  }
  stage.label_drop {
    values = ["filename"]
  }
  forward_to = [loki.write.local.receiver]
}
