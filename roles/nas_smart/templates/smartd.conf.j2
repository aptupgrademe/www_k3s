# Managed by Ansible (nas_smart) – do not edit manually
# SMART monitoring for all drives

# Default settings for all drives:
# -a          : enable all SMART checks
# -o on       : automatic offline testing
# -S on       : automatic attribute saving
# -s S/../.././02  : short self-test every day at 02:00
# -s L/../../6/03  : long self-test every Saturday at 03:00
# -W 4,45,50  : temperature: report if diff>4°C, warn at 45°C, critical at 50°C
# -m          : send email on errors
# -M exec     : use sendmail (msmtp provides /usr/sbin/sendmail)

DEFAULT -a -o on -S on \
  -s S/../.././02 \
  -s L/../../6/03 \
  -W 4,45,50 \
  -m {{ email | default('root') }} \
  -M exec /usr/share/smartmontools/smartd-runner

# OS disk (sdb – WD SSD)
/dev/disk/by-id/{{ nas_disk_id_os }}

# RAIDZ1 disks (sda, sdc, sdd – WD Red SA500)
{% for disk_id in nas_disk_id_zfs %}
/dev/disk/by-id/{{ disk_id }}
{% endfor %}

# External HDD (sde – Toshiba)
{% if nas_disk_id_usb is defined %}
/dev/disk/by-id/{{ nas_disk_id_usb }} -W 4,42,45
{% endif %}
