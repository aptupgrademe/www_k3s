#!/usr/bin/python3
# Managed by Ansible (role common_firewall) - do not edit on the host.
#
# ssh-geo-update - build the SSH country allowlist for nftables.
#
# Reads /etc/ssh-geo.conf (JSON: {"countries": ["DE"], "extra": ["198.51.100.7/32"]}),
# downloads RIPE's delegation statistics, keeps the IPv4/IPv6 blocks of those
# countries, merges adjacent blocks and writes /etc/nftables/ssh-geo.nft:
#
#   flush set inet filter ssh_geo4 / ssh_geo6, then add the elements.
#
# /etc/sysconfig/nftables.conf includes that file, so every firewall reload
# (and every boot) refills the sets in the same atomic transaction that
# recreates the table. Without --no-apply the file is also loaded live (only
# the two sets change; fail2ban's sets and all other rules stay untouched).
#
# Fail-safe: on any error (download, parse, a list that suddenly shrinks) the
# existing file stays in place and nothing is applied. An empty or broken list
# would lock everybody out of SSH, so it never replaces a working one.
#
# Only countries in the RIPE NCC region (Europe, Middle East, parts of Central
# Asia) are covered - that is the only file downloaded.

import ipaddress
import json
import os
import subprocess
import sys
import tempfile
import time
import urllib.request

CONF = "/etc/ssh-geo.conf"
OUT = "/etc/nftables/ssh-geo.nft"
SRC = "https://ftp.ripe.net/pub/stats/ripencc/delegated-ripencc-extended-latest"
MAX_AGE_DAYS = 14   # RIPE publishes daily; older data means something is wrong
MIN_SHARE = 0.8     # a new list must keep at least 80 % of the previous blocks


def die(msg):
    print(f"ssh-geo-update: ERROR: {msg} - keeping the current list", file=sys.stderr)
    sys.exit(1)


def previous_count():
    try:
        with open(OUT) as f:
            for line in f:
                if line.startswith("# blocks:"):
                    return int(line.split()[2])
    except (OSError, ValueError, IndexError):
        pass
    return 0


def main():
    no_apply = "--no-apply" in sys.argv[1:]
    try:
        with open(CONF) as f:
            conf = json.load(f)
    except (OSError, ValueError) as e:
        die(f"cannot read {CONF}: {e}")
    countries = {c.upper() for c in conf.get("countries", [])}
    if not countries:
        die(f"no countries in {CONF}")

    try:
        with urllib.request.urlopen(SRC, timeout=120) as r:
            data = r.read().decode("ascii", "replace").splitlines()
    except Exception as e:  # noqa: BLE001 - any download problem is fatal here
        die(f"download failed: {e}")

    # Header: 2|ripencc|<serial>|<records>|<startdate>|<enddate YYYYMMDD>|<UTC offset>
    head = next((line for line in data if line[:1].isdigit()), "")
    parts = head.split("|")
    if len(parts) < 6 or parts[1] != "ripencc":
        die("unexpected file format (no ripencc header)")
    try:
        age = (time.time() - time.mktime(time.strptime(parts[5], "%Y%m%d"))) / 86400
    except ValueError:
        die(f"unexpected date in header: {parts[5]!r}")
    if age > MAX_AGE_DAYS:
        die(f"RIPE data is {age:.0f} days old")

    v4, v6 = [], []
    for line in data:
        p = line.split("|")
        if len(p) < 7 or p[1] not in countries or p[6] not in ("allocated", "assigned"):
            continue
        try:
            if p[2] == "ipv4":
                start = ipaddress.IPv4Address(p[3])
                v4 += ipaddress.summarize_address_range(start, start + int(p[4]) - 1)
            elif p[2] == "ipv6":
                v6.append(ipaddress.IPv6Network(f"{p[3]}/{p[4]}"))
        except ValueError:
            continue
    for cidr in conf.get("extra", []):
        net = ipaddress.ip_network(cidr, strict=False)
        (v4 if net.version == 4 else v6).append(net)
    v4 = list(ipaddress.collapse_addresses(v4))
    v6 = list(ipaddress.collapse_addresses(v6))

    blocks = len(v4) + len(v6)
    if not v4:
        die("no IPv4 blocks found for " + ",".join(sorted(countries)))
    old = previous_count()
    if old and blocks < old * MIN_SHARE:
        die(f"list shrank from {old} to {blocks} blocks (more than {100 - MIN_SHARE * 100:.0f} %)")

    def chunks(nets):
        items = [str(n) for n in nets]
        return ",\n  ".join(", ".join(items[i:i + 6]) for i in range(0, len(items), 6))

    text = [
        f"# Generated by /usr/local/sbin/ssh-geo-update on {time.strftime('%Y-%m-%d %H:%M %Z')}",
        f"# Source: {SRC} (data as of {parts[5]})",
        f"# Countries: {','.join(sorted(countries))}  extra: {','.join(conf.get('extra', [])) or '-'}",
        f"# blocks: {blocks} ({len(v4)} IPv4, {len(v6)} IPv6)",
        "# Included by /etc/sysconfig/nftables.conf - do not edit.",
        "flush set inet filter ssh_geo4",
        "flush set inet filter ssh_geo6",
        "add element inet filter ssh_geo4 {\n  " + chunks(v4) + "\n}",
    ]
    if v6:
        text.append("add element inet filter ssh_geo6 {\n  " + chunks(v6) + "\n}")

    fd, tmp = tempfile.mkstemp(prefix=".ssh-geo.", dir=os.path.dirname(OUT))
    try:
        with os.fdopen(fd, "w") as f:
            f.write("\n".join(text) + "\n")
        os.chmod(tmp, 0o644)
        live = not no_apply and subprocess.run(
            ["nft", "list", "set", "inet", "filter", "ssh_geo4"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        if live:
            chk = subprocess.run(["nft", "-c", "-f", tmp], capture_output=True, text=True)
            if chk.returncode != 0:
                die(f"nft rejected the new list: {chk.stderr.strip()}")
        os.replace(tmp, OUT)
        tmp = None
        try:  # keep the etc_t label the nftables unit needs to read the file at boot
            subprocess.run(["restorecon", OUT], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            pass
    finally:
        if tmp and os.path.exists(tmp):
            os.unlink(tmp)

    if live:
        res = subprocess.run(["nft", "-f", OUT], capture_output=True, text=True)
        if res.returncode != 0:
            die(f"loading the new list failed: {res.stderr.strip()}")
    state = "applied live" if live else "written (applied with the next firewall reload)"
    print(f"ssh-geo-update: {len(v4)} IPv4 + {len(v6)} IPv6 blocks for "
          f"{','.join(sorted(countries))} {state} (was {old or 'none'})")


if __name__ == "__main__":
    main()
