#!/usr/bin/python3
# {{ ansible_managed }}
# Nightly Trivy scan of every image the cluster runs (common_trivy).
#   1. update the vulnerability DB once
#   2. scan each running image straight from containerd (registry only as
#      the fallback for images containerd cannot export any more)
#   3. write node_exporter textfile metrics (Grafana) and one JSON per image
#   4. mail ONLY the fixable CRITICAL/HIGH findings that were not there on
#      the previous run - a finding that stays does not mail again
import datetime, json, os, re, subprocess, sys

TRIVY = "/usr/local/bin/trivy"
CACHE = "{{ trivy_cache_dir }}"
REPORTS = "{{ trivy_report_dir }}/reports"
STATE = "{{ trivy_report_dir }}/last-findings.json"
PROM = "{{ trivy_textfile_dir }}/trivy.prom"
IGNORE = "{{ trivy_report_dir }}/.trivyignore"
MAIL_TO = "{{ trivy_mail }}"
MAIL_SEV = {{ trivy_mail_severities | to_json }}
HOST = "{{ inventory_hostname }}"
ENV = dict(os.environ,
           CONTAINERD_ADDRESS="/run/k3s/containerd/containerd.sock",
           CONTAINERD_NAMESPACE="k8s.io")
SEVERITIES = ["CRITICAL", "HIGH", "MEDIUM", "LOW", "UNKNOWN"]
# Below: plain Python - raw, because its f-strings use double braces like Jinja.
{% raw %}


def running_images():
    jp = ('{range .items[*]}{range .status.containerStatuses[*]}{.image}{"\\n"}{end}'
          '{range .status.initContainerStatuses[*]}{.image}{"\\n"}{end}{end}')
    # Running pods only: finished Job pods (helm-install, CronJob runs) do
    # not run anything - their images showed up as findings before.
    out = subprocess.run(["/usr/local/bin/k3s", "kubectl", "get", "pods", "-A",
                          "--field-selector=status.phase=Running", "-o", f"jsonpath={jp}"],
                         check=True, capture_output=True, text=True).stdout
    return sorted({line.strip() for line in out.splitlines() if line.strip()})


def esc(v):
    return v.replace("\\", "\\\\").replace('"', '\\"')


def main():
    os.makedirs(REPORTS, exist_ok=True)
    lines = [
        "# HELP trivy_image_vulnerabilities Vulnerabilities per running image (common_trivy)",
        "# TYPE trivy_image_vulnerabilities gauge",
    ]
    ok_lines = ["# HELP trivy_image_scan_ok 1 = the last scan of this image worked",
                "# TYPE trivy_image_scan_ok gauge"]
    findings, failed = {}, []

    db = subprocess.run([TRIVY, "image", "--download-db-only", "--cache-dir", CACHE, "--quiet"],
                        env=ENV, capture_output=True, text=True)
    db_ok = db.returncode == 0
    if not db_ok:
        print("DB update failed:", db.stderr.strip()[-500:], file=sys.stderr)

    for image in running_images() if db_ok else []:
        name = re.sub(r"[^A-Za-z0-9_.-]", "_", image)
        out = os.path.join(REPORTS, name + ".json")
        # containerd first; the registry ("remote") only as a second try for
        # images whose compressed layers containerd already discarded after
        # unpacking (metrics-server, kube-state-metrics). Trivy's own
        # "containerd,remote" does not help there: it falls back only when
        # the image is missing, not when a layer is.
        for src in ("containerd", "remote"):
            r = subprocess.run([TRIVY, "image", "--image-src", src, "--cache-dir", CACHE,
                                "--skip-db-update", "--scanners", "vuln", "--ignorefile", IGNORE,
                                "--format", "json", "--quiet", "--timeout", "15m", "-o", out, image],
                               env=ENV, capture_output=True, text=True)
            if r.returncode == 0:
                break
        ok = r.returncode == 0
        ok_lines.append(f'trivy_image_scan_ok{{image="{esc(image)}"}} {int(ok)}')
        if not ok:
            failed.append(image)
            print(f"scan failed: {image}: {r.stderr.strip()[-300:]}", file=sys.stderr)
            continue
        counts = {(s, f): 0 for s in SEVERITIES for f in (True, False)}
        with open(out) as fh:
            report = json.load(fh)
        for res in report.get("Results") or []:
            for v in res.get("Vulnerabilities") or []:
                sev = v.get("Severity", "UNKNOWN")
                fixed = bool(v.get("FixedVersion"))
                counts[(sev if sev in SEVERITIES else "UNKNOWN", fixed)] += 1
                if fixed and sev in MAIL_SEV:
                    key = f'{image}|{v["VulnerabilityID"]}|{v["PkgName"]}'
                    findings[key] = {"image": image, "id": v["VulnerabilityID"], "pkg": v["PkgName"],
                                     "severity": sev, "installed": v.get("InstalledVersion", ""),
                                     "fixed": v.get("FixedVersion", ""), "target": res.get("Target", "")}
        for (sev, fixed), n in sorted(counts.items()):
            lines.append(f'trivy_image_vulnerabilities{{image="{esc(image)}",severity="{sev}",'
                         f'fixable="{str(fixed).lower()}"}} {n}')

    lines += ok_lines + [
        "# HELP trivy_db_update_ok 1 = the vulnerability DB update worked",
        "# TYPE trivy_db_update_ok gauge",
        f"trivy_db_update_ok {int(db_ok)}",
        "# HELP trivy_last_run_timestamp_seconds End of the last scan run",
        "# TYPE trivy_last_run_timestamp_seconds gauge",
        f"trivy_last_run_timestamp_seconds {int(datetime.datetime.now().timestamp())}",
    ]
    # write + rename: node_exporter never reads a half-written file
    with open(PROM + ".tmp", "w") as fh:
        fh.write("\n".join(lines) + "\n")
    os.replace(PROM + ".tmp", PROM)

    if not db_ok:
        return 1

    try:
        with open(STATE) as fh:
            previous = json.load(fh)
    except (OSError, ValueError):
        previous = {}
    new = [findings[k] for k in sorted(findings) if k not in previous]
    gone = [previous[k] for k in sorted(previous) if k not in findings]
    with open(STATE + ".tmp", "w") as fh:
        json.dump(findings, fh, indent=1)
    os.replace(STATE + ".tmp", STATE)

    if new:
        body = [f"Trivy found {len(new)} new fixable {'/'.join(MAIL_SEV)} finding(s) on {HOST}.",
                f"Open in total: {len(findings)}, gone since the last run: {len(gone)}.", "",
                "Fix: a rebuilt image under the same tag -> blog-update.yml / nextcloud-update.yml",
                "(image refresh); otherwise raise the image pin in versions.yml.", ""]
        for f in new:
            body.append(f'{f["severity"]:8} {f["id"]:20} {f["pkg"]} {f["installed"]} -> {f["fixed"]}')
            body.append(f'         {f["image"]}  ({f["target"]})')
        body += ["", f"Reports: {REPORTS}/", "Grafana: trivy_image_vulnerabilities"]
        subprocess.run(["mail", "-s", f"[{HOST}] Trivy: {len(new)} new fixable finding(s)", MAIL_TO],
                       input="\n".join(body) + "\n", text=True, check=False)
    print(f"images scanned, failed: {len(failed)}; open fixable: {len(findings)}, new: {len(new)}, gone: {len(gone)}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
{% endraw %}
