# Nextcloud CronJob – managed by Ansible (next_k3s_deploy)
# Runs occ cron.php every 5 minutes inside the nextcloud-fpm container.
# The nextcloud-www and nextcloud-data HostPath volumes must be mounted so
# cron.php can access app files and user data without touching the live pod.
apiVersion: batch/v1
kind: CronJob
metadata:
  name: nextcloud-cron
  namespace: nextcloud
spec:
  schedule: "*/5 * * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      template:
        spec:
          restartPolicy: OnFailure
          # cron.php never talks to the Kubernetes API — no SA token needed.
          automountServiceAccountToken: false
          containers:
          - name: cron
            image: {{ nextcloud_image_fpm }}
            # SETUID/SETGID are load-bearing here: the command below runs
            # runuser to drop from root to www-data, which fails outright
            # without them. The remaining three match the fpm container so
            # the same verified set covers both.
            securityContext:
              allowPrivilegeEscalation: false
              capabilities:
                drop: [ALL]
                add: [CHOWN, SETGID, SETUID, DAC_OVERRIDE, FOWNER]
              seccompProfile:
                type: RuntimeDefault
            command:
            - runuser
            - -u
            - www-data
            - --
            - php
            - /var/www/html/cron.php
            volumeMounts:
            - name: nextcloud-www
              mountPath: /var/www/html
            - name: nextcloud-data
              mountPath: /var/www/html/data
            - name: custom-config
              mountPath: /var/www/html/config/custom.config.php
              subPath: custom.config.php
            # cron.php takes the same Redis file locks as the web workers, so
            # it needs the credentials too -- without this it would fail to
            # connect the moment Redis started requiring a password.
            - name: redis-config
              mountPath: /var/www/html/config/redis.config.php
              subPath: redis-config-php
          volumes:
          - name: nextcloud-www
            hostPath:
              path: {{ nextcloud_k3s_www_dir }}
              type: DirectoryOrCreate
          - name: nextcloud-data
            hostPath:
              path: {{ nextcloud_data_dir }}
              type: DirectoryOrCreate
          - name: custom-config
            configMap:
              name: nextcloud-custom-config
          - name: redis-config
            secret:
              secretName: nextcloud-secrets
              items:
              - key: redis-config-php
                path: redis-config-php
              defaultMode: 0444
