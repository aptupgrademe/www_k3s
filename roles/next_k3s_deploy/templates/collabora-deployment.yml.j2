# Collabora CODE Deployment + Service – managed by Ansible (next_k3s_deploy)
# SSL is disabled (terminated by F5 nginx-ingress).
# aliasgroup1 restricts which Nextcloud instances may use this Collabora server.
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: collabora
  namespace: nextcloud
  labels:
    app: collabora
spec:
  replicas: 1
  selector:
    matchLabels:
      app: collabora
  template:
    metadata:
      labels:
        app: collabora
    spec:
      # Collabora never talks to the Kubernetes API — no SA token needed.
      automountServiceAccountToken: false
      containers:
      - name: collabora
        image: {{ nextcloud_image_collabora }}
        # NOTE: deliberately left without capabilities: drop: [ALL] while
        # every other container in this stack got one. Collabora is the most
        # attractive hardening target here -- it parses untrusted documents,
        # which is the whole reason collabora-netpol exists -- but CODE does
        # its own chroot/namespace sandboxing per document, so it needs caps
        # the other images do not (SYS_CHROOT and MKNOD at least). Guessing
        # that set from documentation would risk breaking document editing in
        # a way that only shows up when a user opens a file, so it wants a
        # real test against this image tag first: run the pod with a
        # candidate set in a throwaway namespace and confirm that
        # /hosting/discovery answers AND that a document actually opens.
        #
        # seccompProfile: RuntimeDefault is left off for the same reason --
        # that profile restricts exactly the clone/unshare variants used for
        # namespace sandboxing, so it is not the safe freebie here that it is
        # for the other containers.
        securityContext:
          allowPrivilegeEscalation: false
        env:
        # Restrict to requests originating from our Nextcloud instance
        - name: aliasgroup1
          value: "https://{{ nextcloud_hostname }}"
        # TLS terminated by F5 nginx-ingress, not by Collabora itself
        - name: extra_params
          value: "--o:ssl.enable=false --o:ssl.termination=true --o:num_prealloc_children={{ collabora_num_prealloc }} --o:per_document.max_concurrency={{ collabora_max_concurrency }}"
        - name: DONT_GEN_SSL_CERT
          value: "true"
        ports:
        - containerPort: 9980
          name: http
        resources:
          # Per-host overridable; defaults in group_vars/all.yml. Concurrent-doc
          # capacity scales with the memory limit (~150-200 MB per open document);
          # the 3Gi default serves ~12 simultaneous editors.
          requests:
            memory: "{{ collabora_mem_request }}"
            cpu: "{{ collabora_cpu_request }}"
          limits:
            memory: "{{ collabora_mem_limit }}"
            cpu: "{{ collabora_cpu_limit }}"
        # Startup gate for slow starts; holds liveness/readiness off until
        # Collabora answers discovery (up to ~5 min: 30 x 10s).
        startupProbe:
          httpGet:
            path: /hosting/discovery
            port: 9980
          periodSeconds: 10
          failureThreshold: 30
        readinessProbe:
          httpGet:
            path: /hosting/discovery
            port: 9980
          periodSeconds: 15
          failureThreshold: 3
        # Liveness restarts a wedged Collabora (discovery no longer answering).
        livenessProbe:
          httpGet:
            path: /hosting/discovery
            port: 9980
          periodSeconds: 30
          timeoutSeconds: 5
          failureThreshold: 3
---
apiVersion: v1
kind: Service
metadata:
  name: collabora
  namespace: nextcloud
  labels:
    app: collabora
spec:
  selector:
    app: collabora
  ports:
  - name: http
    port: 9980
    targetPort: 9980
    protocol: TCP
  type: ClusterIP
