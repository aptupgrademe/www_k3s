# Nextcloud K8s Secret – managed by Ansible (next_k3s_deploy)
# stringData: plain-text values here; Kubernetes base64-encodes them on write.
apiVersion: v1
kind: Secret
metadata:
  name: nextcloud-secrets
  namespace: nextcloud
type: Opaque
stringData:
  mysql-host:       "mariadb"
  mysql-database:   "{{ nextcloud_db }}"
  mysql-user:       "{{ nextcloud_user }}"
  mysql-password:   "{{ nextcloud_pass }}"
  admin-user:       "{{ nextcloud_admin_user }}"
  admin-password:   "{{ nextcloud_admin_pass }}"
  redis-host:       "redis"
  redis-port:       "6379"
  # Must match requirepass in /etc/redis/redis.conf (set by next_redis).
  redis-password:   "{{ nextcloud_redis_pass }}"
  # Mounted as /var/www/html/config/redis.config.php. Nextcloud reads
  # config.php first and then every other *.config.php alphabetically, so
  # this file ("r") is applied after custom.config.php ("c") and provides the
  # authoritative Redis connection settings. It lives in the Secret rather
  # than in the custom-config ConfigMap because it carries the password.
  redis-config-php: |
    <?php
    $CONFIG = array(
      'redis' => array(
        'host'     => 'redis',
        'port'     => 6379,
        'password' => '{{ nextcloud_redis_pass }}',
      ),
    );
  smtp-host:        "{{ mail_smtphost }}"
  smtp-port:        "{{ mail_smtpport }}"
  smtp-name:        "{{ mail_smtpname }}"
  smtp-password:    "{{ mail_smtppassword }}"
