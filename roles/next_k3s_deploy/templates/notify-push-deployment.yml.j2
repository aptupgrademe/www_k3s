# notify_push (High Performance Backend) – managed by Ansible (next_k3s_deploy).
# Runs the notify_push binary that ships INSIDE the app, as its own Deployment so
# its readiness never gates the Nextcloud pod. It reads DB + Redis creds from the
# shared code volume's config.php and pushes change events to clients over a
# WebSocket, replacing the ~30s polling every desktop/mobile client does.
#
# Gated by nextcloud_notify_push_enabled. The app ships binaries for aarch64,
# armv7 and x86_64; pick by `uname -m` (a glob would take aarch64 first).
# Only config.php is parsed (no --glob-config): the *.config.php files on the
# hostPath are empty mount-point stubs, and redis is configured in config.php.
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: notify-push
  namespace: nextcloud
  labels:
    app: notify-push
spec:
  replicas: 1
  selector:
    matchLabels:
      app: notify-push
  template:
    metadata:
      labels:
        app: notify-push
      annotations:
        # Changes with the app version -> rolls the pod so the running binary
        # matches the installed app (tasks/notify_push.yml).
        notify-push/app-version: "{{ notify_push_app_version | default('unknown') }}"
    spec:
      automountServiceAccountToken: false
      # config.php is 0640 owned by www-data (33). Root with all capabilities
      # dropped has no DAC override and could not read it.
      securityContext:
        runAsUser: 33
        runAsGroup: 33
        runAsNonRoot: true
      containers:
      - name: notify-push
        image: {{ nextcloud_image_fpm }}
        # The binary only exists after the notify_push app is installed into the
        # shared code volume (tasks/notify_push.yml does that before applying
        # this manifest). Wait for it rather than crash-loop, then exec.
        command: ["/bin/sh", "-c"]
        args:
          - |
            ARCH=$(uname -m)
            echo "notify-push: waiting for the $ARCH binary in the shared code volume ..."
            while :; do
              for d in apps custom_apps; do
                BIN=/var/www/html/$d/notify_push/bin/$ARCH/notify_push
                [ -x "$BIN" ] && break 2
              done
              sleep 10
            done
            echo "notify-push: starting $BIN"
            exec "$BIN" --bind 0.0.0.0 --port {{ notify_push_port | default(7867) }} /var/www/html/config/config.php
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop: [ALL]
          seccompProfile:
            type: RuntimeDefault
        ports:
        - containerPort: {{ notify_push_port | default(7867) }}
          name: push
        volumeMounts:
        - name: nextcloud-www
          mountPath: /var/www/html
          readOnly: true
        resources:
          requests:
            memory: "64Mi"
            cpu: "25m"
          limits:
            memory: "256Mi"
            cpu: "500m"
        # Startup gate: the binary-wait above can take a while on first install.
        startupProbe:
          tcpSocket:
            port: {{ notify_push_port | default(7867) }}
          periodSeconds: 10
          failureThreshold: 60
        readinessProbe:
          tcpSocket:
            port: {{ notify_push_port | default(7867) }}
          periodSeconds: 15
          failureThreshold: 3
        livenessProbe:
          tcpSocket:
            port: {{ notify_push_port | default(7867) }}
          periodSeconds: 30
          timeoutSeconds: 5
          failureThreshold: 3
      volumes:
      # Same host path as the Nextcloud code volume (single node): notify_push
      # reads config.php and its own binary from here, read-only.
      - name: nextcloud-www
        hostPath:
          path: {{ nextcloud_k3s_www_dir }}
          type: DirectoryOrCreate
---
apiVersion: v1
kind: Service
metadata:
  name: notify-push
  namespace: nextcloud
  labels:
    app: notify-push
spec:
  selector:
    app: notify-push
  ports:
  - name: push
    port: {{ notify_push_port | default(7867) }}
    targetPort: {{ notify_push_port | default(7867) }}
    protocol: TCP
  type: ClusterIP
