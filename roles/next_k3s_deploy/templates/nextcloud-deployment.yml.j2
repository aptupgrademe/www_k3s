# Nextcloud Deployment + Service – managed by Ansible (next_k3s_deploy)
# Pod contains two containers:
#   nextcloud-fpm  – PHP-FPM (port 9000)
#   nginx          – Nginx sidecar (port 80), serves static files and proxies PHP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nextcloud
  namespace: nextcloud
  labels:
    app: nextcloud
spec:
  replicas: 1
  # Recreate ensures only one pod accesses the RWO HostPath volumes at a time.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: nextcloud
  template:
    metadata:
      labels:
        app: nextcloud
    spec:
      # Nextcloud/nginx/exporter never talk to the Kubernetes API — no SA token needed.
      automountServiceAccountToken: false
      # -------------------------------------------------------------------
      # Init container: fix HostPath directory ownership for www-data (uid 33)
      # Only chowns the top-level directories (not recursive) so it's fast.
      # -------------------------------------------------------------------
      initContainers:
      - name: init-dirs
        image: {{ nextcloud_image_busybox }}
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop: [ALL]
            add: [CHOWN, FOWNER, DAC_OVERRIDE]
          seccompProfile:
            type: RuntimeDefault
        command:
        - sh
        - -c
        - |
          chown 33:33 /var/www/html /data
          chmod 0755 /var/www/html
          chmod 0770 /data
        volumeMounts:
        - name: nextcloud-www
          mountPath: /var/www/html
        - name: nextcloud-data
          mountPath: /data

      containers:
      # -------------------------------------------------------------------
      # Container 1: Nextcloud PHP-FPM
      # The official image auto-installs on first start when MySQL_* env vars
      # are present and the database is empty.
      # -------------------------------------------------------------------
      - name: nextcloud-fpm
        image: {{ nextcloud_image_fpm }}
        # CHOWN/SETUID/SETGID: the fpm master starts as root and forks workers
        # as www-data. DAC_OVERRIDE/FOWNER: the image entrypoint unpacks
        # Nextcloud into the volume and fixes modes on first start. Verified
        # against this exact image tag before committing.
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop: [ALL]
            add: [CHOWN, SETGID, SETUID, DAC_OVERRIDE, FOWNER]
          seccompProfile:
            type: RuntimeDefault
        env:
        # Database
        - name: MYSQL_HOST
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: mysql-host
        - name: MYSQL_DATABASE
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: mysql-database
        - name: MYSQL_USER
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: mysql-user
        # CIS 5.4.1: files, not plain env vars — env vars are visible via
        # /proc/<pid>/environ, `kubectl describe`, crash dumps, and error
        # handlers that dump the environment. The official nextcloud image
        # shares docker-library's file_env() convention with mariadb/mysql
        # (same upstream pattern, verified live for those two on the blog
        # host — not independently re-verified against this exact image
        # since no Nextcloud host is live yet; check on first real deploy).
        - name: MYSQL_PASSWORD_FILE
          value: /etc/secrets/mysql-password
        # Nextcloud admin (only used during initial install)
        - name: NEXTCLOUD_ADMIN_USER
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: admin-user
        - name: NEXTCLOUD_ADMIN_PASSWORD_FILE
          value: /etc/secrets/admin-password
        # Redis
        - name: REDIS_HOST
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: redis-host
        - name: REDIS_HOST_PORT
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: redis-port
        - name: REDIS_HOST_PASSWORD
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: redis-password
        # Nextcloud URLs and trusted domains
        - name: NEXTCLOUD_TRUSTED_DOMAINS
          value: "{{ nextcloud_hostname }}"
        - name: NEXTCLOUD_DATA_DIR
          value: "/var/www/html/data"
        - name: OVERWRITEPROTOCOL
          value: "https"
        - name: OVERWRITECLIURL
          value: "{{ nextcloud_url }}"
        # Mail
        - name: SMTP_HOST
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: smtp-host
        - name: SMTP_PORT
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: smtp-port
        - name: SMTP_NAME
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: smtp-name
        - name: SMTP_PASSWORD_FILE
          value: /etc/secrets/smtp-password
        - name: SMTP_AUTHTYPE
          value: "LOGIN"
        - name: MAIL_FROM_ADDRESS
          value: "{{ mail_from_address }}"
        - name: MAIL_DOMAIN
          value: "{{ mail_domain }}"
        # PHP limits (for large file uploads, up to 2G). memory_limit must
        # exceed upload_limit (PHP requirement: it needs to be able to
        # allocate at least post_max_size/upload_max_filesize) – 3G leaves
        # headroom above the 2G ceiling. Matches client_max_body_size in
        # nginx-cm.yml.j2 and the nginx.org/client-max-body-size ingress
        # annotation – all three must agree.
        - name: PHP_MEMORY_LIMIT
          value: "3G"
        - name: PHP_UPLOAD_LIMIT
          value: "2G"
        ports:
        - containerPort: 9000
          name: fpm
        volumeMounts:
        - name: nextcloud-www
          mountPath: /var/www/html
        - name: nextcloud-data
          mountPath: /var/www/html/data
        - name: custom-config
          mountPath: /var/www/html/config/custom.config.php
          subPath: custom.config.php
        - name: redis-config
          mountPath: /var/www/html/config/redis.config.php
          subPath: redis-config-php
        - name: fpm-pool-config
          mountPath: /usr/local/etc/php-fpm.d/z-monitoring.conf
          subPath: z-monitoring.conf
        - name: php-config
          mountPath: /usr/local/etc/php/conf.d/opcache.ini
          subPath: opcache.ini
        - name: db-credentials
          mountPath: /etc/secrets
          readOnly: true
        - name: tmp
          mountPath: /tmp
        resources:
          requests:
            memory: "512Mi"   # real idle ~200-300 MB; 512 gives scheduler headroom
            cpu: "250m"
          limits:
            # Raised from 2Gi: PHP_MEMORY_LIMIT is now 3G (needed for 2G
            # uploads), so the container must be allowed to actually reach
            # that. On the current 3.5Gi test host this is tight if Collabora
            # (up to 3Gi) is also under load simultaneously – fine on the
            # 8Gi production hosts this was originally sized for, but worth
            # a real-world check on smaller hosts.
            memory: "4Gi"
            cpu: "1500m"
        readinessProbe:
          tcpSocket:
            port: 9000
          initialDelaySeconds: 30
          periodSeconds: 15
          failureThreshold: 5
        livenessProbe:
          exec:
            command: ["sh", "-c", "kill -0 1"]
          initialDelaySeconds: 120
          periodSeconds: 30
          failureThreshold: 3

      # -------------------------------------------------------------------
      # Container 2: php-fpm_exporter – Prometheus metrics for PHP-FPM
      # Scrapes the FPM status page via FastCGI on 127.0.0.1:9000.
      # Requires pm.status_path = /fpm-status in the FPM pool config.
      # -------------------------------------------------------------------
      - name: php-fpm-exporter
        image: {{ nextcloud_image_fpm_exporter }}
        # Had no securityContext at all, unlike its siblings. Static Go
        # binary on a high port that never switches user: no capabilities.
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop: [ALL]
          seccompProfile:
            type: RuntimeDefault
        env:
        - name: PHP_FPM_SCRAPE_URI
          value: "tcp://127.0.0.1:9000/fpm-status"
        - name: PHP_FPM_FIX_PROCESS_COUNT
          value: "true"
        ports:
        - containerPort: 9253
          name: metrics
        resources:
          requests:
            memory: "16Mi"
            cpu: "10m"
          limits:
            memory: "64Mi"
            cpu: "50m"

      # -------------------------------------------------------------------
      # Container 3: Nginx sidecar
      # Serves static files from the shared volume, proxies PHP to FPM.
      # -------------------------------------------------------------------
      - name: nginx
        image: {{ nextcloud_image_nginx }}
        # NET_BIND_SERVICE: the master binds :80, and once ALL capabilities
        # are dropped even uid 0 loses the implicit permission for ports
        # <1024. CHOWN/SETUID/SETGID: workers are forked as the nginx user.
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop: [ALL]
            add: [CHOWN, SETGID, SETUID, NET_BIND_SERVICE]
          seccompProfile:
            type: RuntimeDefault
        ports:
        - containerPort: 80
          name: http
        volumeMounts:
        - name: nextcloud-www
          mountPath: /var/www/html
          readOnly: true
        - name: nextcloud-data
          mountPath: /var/www/html/data
          readOnly: true
        - name: nginx-config
          mountPath: /etc/nginx/conf.d/default.conf
          subPath: default.conf
        resources:
          requests:
            memory: "64Mi"
            cpu: "50m"
          limits:
            memory: "256Mi"
            cpu: "500m"
        readinessProbe:
          tcpSocket:
            port: 80
          initialDelaySeconds: 30
          periodSeconds: 15
          failureThreshold: 5

      # -------------------------------------------------------------------
      # Volumes
      # -------------------------------------------------------------------
      volumes:
      - name: nextcloud-www
        hostPath:
          path: {{ nextcloud_k3s_www_dir }}
          type: DirectoryOrCreate
      - name: nextcloud-data
        hostPath:
          path: {{ nextcloud_data_dir }}
          type: DirectoryOrCreate
      - name: nginx-config
        configMap:
          name: nextcloud-nginx-config
      - name: custom-config
        configMap:
          name: nextcloud-custom-config
      - name: redis-config
        secret:
          secretName: nextcloud-secrets
          items:
          - key: redis-config-php
            path: redis-config-php
          # Secret volumes are owned by root:root, and PHP-FPM reads this as
          # www-data (uid 33), so it has to be world-readable inside the
          # container. Same pattern as the exporter credentials on the blog.
          defaultMode: 0444
      # CIS 5.4.1: DB/admin/SMTP passwords delivered as files, not plain env vars.
      - name: db-credentials
        secret:
          secretName: nextcloud-secrets
          items:
          - key: mysql-password
            path: mysql-password
          - key: admin-password
            path: admin-password
          - key: smtp-password
            path: smtp-password
          defaultMode: 0444
      - name: fpm-pool-config
        configMap:
          name: nextcloud-fpm-pool-config
      - name: php-config
        configMap:
          name: nextcloud-php-config
      # RAM-backed tmpfs for PHP-FPM temp files (uploads, occ tmp, previews).
      # Content is lost on pod restart – acceptable for transient files.
      # 256Mi (not 64Mi): `occ app:install` downloads the app tarball AND
      # extracts it into /tmp simultaneously. richdocuments' tarball alone is
      # ~14.5MB compressed; verified live that 64Mi truncates the extraction
      # ("Archive may be corrupted" – file size mismatch), causing the app to
      # silently fail to install and Collabora documents to download instead
      # of opening in the editor. 256Mi leaves comfortable headroom for this
      # and any other app of similar or larger size.
      - name: tmp
        emptyDir:
          medium: Memory
          sizeLimit: 256Mi
---
apiVersion: v1
kind: Service
metadata:
  name: nextcloud
  namespace: nextcloud
  labels:
    app: nextcloud
spec:
  selector:
    app: nextcloud
  ports:
  - name: http
    port: 80
    targetPort: 80
    protocol: TCP
  type: ClusterIP
