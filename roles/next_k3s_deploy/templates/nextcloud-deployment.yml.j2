# Nextcloud Deployment + Service – managed by Ansible (next_k3s_deploy)
# Pod contains two containers:
#   nextcloud-fpm  – PHP-FPM (port 9000)
#   nginx          – Nginx sidecar (port 80), serves static files and proxies PHP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nextcloud
  namespace: nextcloud
  labels:
    app: nextcloud
spec:
  replicas: 1
  # Recreate ensures only one pod accesses the RWO HostPath volumes at a time.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: nextcloud
  template:
    metadata:
      labels:
        app: nextcloud
    spec:
      # -------------------------------------------------------------------
      # Init container: fix HostPath directory ownership for www-data (uid 33)
      # Only chowns the top-level directories (not recursive) so it's fast.
      # -------------------------------------------------------------------
      initContainers:
      - name: init-dirs
        image: {{ nextcloud_image_busybox }}
        command:
        - sh
        - -c
        - |
          chown 33:33 /var/www/html /data
          chmod 0755 /var/www/html
          chmod 0770 /data
        volumeMounts:
        - name: nextcloud-www
          mountPath: /var/www/html
        - name: nextcloud-data
          mountPath: /data

      containers:
      # -------------------------------------------------------------------
      # Container 1: Nextcloud PHP-FPM
      # The official image auto-installs on first start when MySQL_* env vars
      # are present and the database is empty.
      # -------------------------------------------------------------------
      - name: nextcloud-fpm
        image: {{ nextcloud_image_fpm }}
        securityContext:
          allowPrivilegeEscalation: false
        env:
        # Database
        - name: MYSQL_HOST
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: mysql-host
        - name: MYSQL_DATABASE
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: mysql-database
        - name: MYSQL_USER
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: mysql-user
        - name: MYSQL_PASSWORD
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: mysql-password
        # Nextcloud admin (only used during initial install)
        - name: NEXTCLOUD_ADMIN_USER
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: admin-user
        - name: NEXTCLOUD_ADMIN_PASSWORD
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: admin-password
        # Redis
        - name: REDIS_HOST
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: redis-host
        - name: REDIS_HOST_PORT
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: redis-port
        # Nextcloud URLs and trusted domains
        - name: NEXTCLOUD_TRUSTED_DOMAINS
          value: "{{ nextcloud_hostname }}"
        - name: NEXTCLOUD_DATA_DIR
          value: "/var/www/html/data"
        - name: OVERWRITEPROTOCOL
          value: "https"
        - name: OVERWRITECLIURL
          value: "{{ nextcloud_url }}"
        # Mail
        - name: SMTP_HOST
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: smtp-host
        - name: SMTP_PORT
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: smtp-port
        - name: SMTP_NAME
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: smtp-name
        - name: SMTP_PASSWORD
          valueFrom:
            secretKeyRef:
              name: nextcloud-secrets
              key: smtp-password
        - name: SMTP_AUTHTYPE
          value: "LOGIN"
        - name: MAIL_FROM_ADDRESS
          value: "{{ mail_from_address }}"
        - name: MAIL_DOMAIN
          value: "{{ mail_domain }}"
        # PHP limits (for large file uploads)
        - name: PHP_MEMORY_LIMIT
          value: "512M"
        - name: PHP_UPLOAD_LIMIT
          value: "300M"
        ports:
        - containerPort: 9000
          name: fpm
        volumeMounts:
        - name: nextcloud-www
          mountPath: /var/www/html
        - name: nextcloud-data
          mountPath: /var/www/html/data
        - name: custom-config
          mountPath: /var/www/html/config/custom.config.php
          subPath: custom.config.php
        - name: fpm-pool-config
          mountPath: /usr/local/etc/php-fpm.d/z-monitoring.conf
          subPath: z-monitoring.conf
        - name: tmp
          mountPath: /tmp
        resources:
          requests:
            memory: "512Mi"   # real idle ~200-300 MB; 512 gives scheduler headroom
            cpu: "250m"
          limits:
            memory: "2Gi"     # 8 GB host: plenty of room for sync, preview, large uploads
            cpu: "1500m"
        readinessProbe:
          tcpSocket:
            port: 9000
          initialDelaySeconds: 30
          periodSeconds: 15
          failureThreshold: 5
        livenessProbe:
          exec:
            command: ["sh", "-c", "kill -0 1"]
          initialDelaySeconds: 120
          periodSeconds: 30
          failureThreshold: 3

      # -------------------------------------------------------------------
      # Container 2: php-fpm_exporter – Prometheus metrics for PHP-FPM
      # Scrapes the FPM status page via FastCGI on 127.0.0.1:9000.
      # Requires pm.status_path = /fpm-status in the FPM pool config.
      # -------------------------------------------------------------------
      - name: php-fpm-exporter
        image: {{ nextcloud_image_fpm_exporter }}
        env:
        - name: PHP_FPM_SCRAPE_URI
          value: "tcp://127.0.0.1:9000/fpm-status"
        - name: PHP_FPM_FIX_PROCESS_COUNT
          value: "true"
        ports:
        - containerPort: 9253
          name: metrics
        resources:
          requests:
            memory: "16Mi"
            cpu: "10m"
          limits:
            memory: "64Mi"
            cpu: "50m"

      # -------------------------------------------------------------------
      # Container 3: Nginx sidecar
      # Serves static files from the shared volume, proxies PHP to FPM.
      # -------------------------------------------------------------------
      - name: nginx
        image: {{ nextcloud_image_nginx }}
        securityContext:
          allowPrivilegeEscalation: false
        ports:
        - containerPort: 80
          name: http
        volumeMounts:
        - name: nextcloud-www
          mountPath: /var/www/html
          readOnly: true
        - name: nextcloud-data
          mountPath: /var/www/html/data
          readOnly: true
        - name: nginx-config
          mountPath: /etc/nginx/conf.d/default.conf
          subPath: default.conf
        resources:
          requests:
            memory: "64Mi"
            cpu: "50m"
          limits:
            memory: "256Mi"
            cpu: "500m"
        readinessProbe:
          tcpSocket:
            port: 80
          initialDelaySeconds: 30
          periodSeconds: 15
          failureThreshold: 5

      # -------------------------------------------------------------------
      # Volumes
      # -------------------------------------------------------------------
      volumes:
      - name: nextcloud-www
        hostPath:
          path: {{ nextcloud_k3s_www_dir }}
          type: DirectoryOrCreate
      - name: nextcloud-data
        hostPath:
          path: {{ nextcloud_data_dir }}
          type: DirectoryOrCreate
      - name: nginx-config
        configMap:
          name: nextcloud-nginx-config
      - name: custom-config
        configMap:
          name: nextcloud-custom-config
      - name: fpm-pool-config
        configMap:
          name: nextcloud-fpm-pool-config
      # RAM-backed tmpfs for PHP-FPM temp files (uploads, occ tmp, previews).
      # Content is lost on pod restart – acceptable for transient files.
      - name: tmp
        emptyDir:
          medium: Memory
          sizeLimit: 64Mi
---
apiVersion: v1
kind: Service
metadata:
  name: nextcloud
  namespace: nextcloud
  labels:
    app: nextcloud
spec:
  selector:
    app: nextcloud
  ports:
  - name: http
    port: 80
    targetPort: 80
    protocol: TCP
  type: ClusterIP
