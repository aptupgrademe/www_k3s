# Managed by Ansible – do not edit manually
# Detects brute-force POST attempts against Nextcloud's /login.
# Log source: nginx-ingress (F5) access log, containerd-prefixed format:
#   2026-06-19T14:24:11Z stdout F <client_ip> - - [nginx_time] "POST /login HTTP/1.1" 200 ...
# Mirrors nginx-k3s-wp-login.conf.j2.

[Definition]
failregex = ^\S+\s+stdout\s+F\s+<HOST>\s+-\s+-\s+\[.+?\]\s+"POST /login\s+HTTP/\S+"\s+\d{3}

ignoreregex =
