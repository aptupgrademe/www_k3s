# Managed by Ansible – do not edit manually
# Detects brute-force POST attempts against Nextcloud's login. Both paths:
# without htaccess.RewriteBase the login form posts to /index.php/login - the
# old pattern (/login only) never matched a real login (found 2026-10-26).
# Log source: nginx-ingress (F5) access log, containerd-prefixed format:
#   2026-06-19T14:24:11Z stdout F <client_ip> - - [nginx_time] "POST /login HTTP/1.1" 200 ...
# Mirrors nginx-k3s-wp-login.conf.j2.

[Definition]
failregex = ^\S+\s+stdout\s+F\s+<HOST>\s+-\s+-\s+\[.+?\]\s+"POST /(?:index\.php/)?login(?:\?\S*)?\s+HTTP/\S+"\s+\d{3}

ignoreregex =
