# Managed by Ansible – do not edit manually
# =============================================================================
# Fail2Ban action: write banned IPs directly into the nftables banned4/banned6
# sets defined in /etc/sysconfig/nftables.conf (role: common_firewall).
#
# The sets use native nftables timeout – the IP auto-expires after <bantime>
# seconds without any fail2ban unban action needed.  The explicit actionunban
# is kept as a best-effort cleanup in case fail2ban restarts before expiry.
#
# <nftset> depends on the address family of the banned IP: fail2ban reads the
# [Init?family=inet6] section for IPv6 addresses. Until 2026-10-14 the jails
# passed nftset=banned4 for everything, so every IPv6 ban failed with
# "Address family for hostname not supported" (on all three hosts): fail2ban
# logged "Ban", but the firewall never blocked the address.
# =============================================================================

#
# <setname> is passed per jail in jail.local (action = nftables-banned-sets
# [setname=f2b_<name>]): every jail has its own set pair since 2026-10-21, so
# an unban removes the address only from that jail's set. With one shared set
# the 1-hour scanner unban lifted the 24-hour bad-paths ban of the same
# address, and every short ban could end a 30-day recidive ban.
# =============================================================================

[Definition]
actionban   = nft add element inet filter <nftset> { <ip> timeout <bantime>s }
actionunban = nft delete element inet filter <nftset> { <ip> } 2>/dev/null; true

[Init]
setname = banned
nftset = <setname>4

[Init?family=inet6]
nftset = <setname>6
