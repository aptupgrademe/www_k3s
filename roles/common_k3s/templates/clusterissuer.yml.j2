# cert-manager ClusterIssuer – Let's Encrypt production
# Managed by Ansible role common_k3s
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    # Let's Encrypt production endpoint
    server: https://acme-v02.api.letsencrypt.org/directory
    email: {{ email }}
    # Secret to store the ACME account private key
    privateKeySecretRef:
      name: letsencrypt-prod-account-key
    solvers:
    # HTTP-01 challenge answered by nginx-ingress on port 80.
    # The solver Ingress is created as a "minion" so F5 nginx-ingress merges
    # its challenge location block into the existing master server block for
    # the same hostname.  Without mergeable-ingress-type the solver Ingress is
    # silently ignored because a conflicting Ingress for the same host exists.
    - http01:
        ingress:
          ingressClassName: nginx
          ingressTemplate:
            metadata:
              annotations:
                nginx.org/ssl-redirect: "false"
                nginx.org/mergeable-ingress-type: "minion"
