# ingress-nginx Helm values – managed by Ansible (common_k3s)
# DaemonSet with hostNetwork binds directly to the host's ports 80/443.
controller:
  kind: DaemonSet
  hostNetwork: true
  dnsPolicy: ClusterFirstWithHostNet
  hostPort:
    enabled: true
  service:
    type: ClusterIP
  config:
    use-forwarded-headers: "true"
    compute-full-forwarded-for: "true"
    use-proxy-protocol: "false"

    # --- TLS hardening ---
    # Only TLS 1.2 and 1.3; disable legacy protocols.
    ssl-protocols: "TLSv1.2 TLSv1.3"
    # Modern ECDHE cipher suite; no RSA key exchange, no CBC mode ciphers.
    ssl-ciphers: "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305"
    ssl-session-cache: "shared:SSL:10m"
    ssl-session-timeout: "1d"
    # OCSP stapling: the controller attaches the CA's signed response to the
    # TLS handshake so browsers can verify revocation without an extra round-trip.
    ssl-stapling: "true"
    ssl-stapling-verify: "true"

    # --- HTTP/3 (QUIC) ---
    # Requires UDP/443 open in nftables (common_firewall / fw.nft.j2).
    # The controller advertises HTTP/3 via the Alt-Svc response header.
    http3: "true"
    use-http2: "true"

    # --- Compression ---
    use-gzip: "true"
    gzip-level: "6"
    gzip-types: "text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml"

    # --- Snippet annotations ---
    # allow-snippet-annotations enables configuration-snippet and server-snippet
    # annotations on Ingress resources.
    # annotations-risk-level: "Critical" is required since ingress-nginx 4.12 –
    # snippet annotations are classified as Critical risk and blocked by default.
    allow-snippet-annotations: "true"
    annotations-risk-level: "Critical"

    # --- Rate-limit zones ---
    # Used by Ingress server-snippet annotations.
    # nc_login: Nextcloud /login endpoint
    # wp_login: WordPress /wp-login.php endpoint
    http-snippet: |
      limit_req_zone $binary_remote_addr zone=nc_login:10m rate=5r/s;
      limit_req_zone $binary_remote_addr zone=wp_login:10m rate=5r/s;
