# nginx-ingress Helm values – managed by Ansible (common_k3s)
# F5 NGINX Ingress Controller (nginx-stable/nginx-ingress).
# DaemonSet with hostNetwork binds directly to the host's ports 80/443.
controller:
  kind: daemonset
  hostNetwork: true
  dnsPolicy: ClusterFirstWithHostNet
  hostPort:
    enable: true
  service:
    type: ClusterIP

  # Allow server-snippets and location-snippets on Ingress resources.
  # Used for rate-limiting location blocks and security headers.
  enableSnippets: true

  config:
    entries:
      # --- Hide nginx version from Server header ---
      server-tokens: "false"

      # --- HTTP/2 ---
      # Enables multiplexing, header compression (HPACK) and ALPN negotiation.
      http2: "true"

      # --- Upstream connection reuse ---
      # Without this, the controller opens a new TCP connection to the backend
      # pod for every single proxied request (verified live: the generated
      # upstream block had no keepalive directive at all). This pools idle
      # connections per worker instead, for every upstream cluster-wide.
      # Global ConfigMap key only — there is no working per-Ingress annotation
      # for this in the F5 nginx-ingress (nginx.org) controller.
      keepalive: "32"

      # --- TLS hardening ---
      ssl-protocols: "TLSv1.2 TLSv1.3"
      ssl-ciphers: "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305"
      # Let the client choose the cipher for TLS 1.3 (RFC 8446 best practice).
      ssl-prefer-server-ciphers: "false"

      # --- Compression ---
      gzip: "on"
      # Brotli: 15-25 % smaller than gzip for text/JS/CSS on modern browsers.
      brotli: "true"
      brotli-level: "6"
      brotli-types: "text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml font/woff font/woff2"

      # --- Custom http-context directives ---
      # ssl_session_tickets, OCSP stapling, gzip/brotli tuning, rate-limit zones.
      # F5 NGINX exposes these via http-snippets rather than individual entries.
      http-snippets: |
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;
        # Disable session tickets: forces fresh key derivation per session,
        # preserving Perfect Forward Secrecy even if a ticket key is compromised.
        ssl_session_tickets off;

        # OCSP stapling: nginx fetches and caches the CA's revocation response,
        # attaching it to the TLS handshake so browsers need no extra round-trip.
        # resolver is required so nginx can look up the OCSP responder hostname.
        ssl_stapling on;
        ssl_stapling_verify on;
        resolver 1.1.1.1 8.8.8.8 valid=60s;
        resolver_timeout 5s;

        gzip_comp_level 6;
        gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml;

        # Rate-limit zones – referenced by nginx.org/server-snippets annotations.
        # nc_login: Nextcloud /login endpoint
        # wp_login: WordPress /wp-login.php endpoint
        limit_req_zone $binary_remote_addr zone=nc_login:10m rate=5r/s;
        limit_req_zone $binary_remote_addr zone=wp_login:10m rate=5r/s;
