.vscode
.git
.ansible
.claude

# Ansible Vault password file – never commit this
.vault_pass

# Vault credential files – never commit real passwords.
# Copy vault.yml.example → vault.yml and fill in your values.
**/vault.yml

# Host-specific variables – contain real IPs, hostnames and domains.
# Copy vars.yml.example → vars.yml and fill in your values.
inventory/host_vars/*/vars.yml

# Main inventory – contains real server IPs.
# Copy hosts.yml.example → hosts.yml and fill in your values.
inventory/hosts.yml

# Internal fix/audit notes – never published to a remote.
docs/*-fixes-*.md
docs/*-audit*.md

# PGP PRIVATE key + revocation cert for the blog impressum key.
# NEVER commit these – not to GitHub, not even to the internal repo.
# Only publickey.asc (the public half) is tracked and served at /publickey.asc.
roles/blog_k3s_deploy/files/privatekey.asc
roles/blog_k3s_deploy/files/*.rev
